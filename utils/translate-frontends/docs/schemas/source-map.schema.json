{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neversight.github.io/NeverC/translate/source-map.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "neverc.translate.source-map"
    },
    "version": {
      "const": 1
    },
    "generated_file": {
      "type": "string"
    },
    "generated_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "generated_start_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "generated_end_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "column": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "required": [
          "generated_start_line",
          "generated_end_line",
          "file",
          "line",
          "column"
        ],
        "additionalProperties": false
      }
    },
    "additional_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "generated_file": {
            "type": "string"
          },
          "generated_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "generated_start_line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "generated_end_line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "column": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                }
              },
              "required": [
                "generated_start_line",
                "generated_end_line",
                "file",
                "line",
                "column"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "generated_file",
          "generated_sha256",
          "entries"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "version",
    "generated_file",
    "generated_sha256",
    "entries"
  ],
  "additionalProperties": false
}
