      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nstruct Entry {\n  int key;\n  double operator==(const Entry& other) const { return key == other.key; }\n};\nint main() {\n  const std::list<Entry> first{{2}};\n  const std::list<Entry> second{{3}};\n  return first == second;\n}\n",
      "source_sha256": "780a8d5744b414c7d6740611c4c2a46298929103dd47e064f53ff67d7809f049"
    },
