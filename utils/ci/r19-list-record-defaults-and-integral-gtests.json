    {
      "name": "list-record-dependent-default-resize",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nstruct Entry { int seed = 3; int total = seed * 2; int delta = total - 1; };\nint main() {\n  std::list<Entry> rows(1);\n  auto retained = rows.begin();\n  retained->seed = 10;\n  rows.resize(3);\n  if (retained != rows.begin() || retained->seed != 10 || retained->delta != 5) return 1;\n  return rows.back().seed != 3 || rows.back().total != 6 || rows.back().delta != 5;\n}\n",
      "source_sha256": "b6f5ac08c8bf6391a0b278722a19d81b6c9a4f0aa5bfc323877f10f0ff291d1a"
    },
    {
      "name": "forward-list-record-dependent-default-emplacement",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nstruct Entry { int key = -2; int tag = -key; bool selected = key < 0 && tag == 2; };\nint main() {\n  std::forward_list<Entry> rows;\n  auto it = rows.emplace_after(rows.before_begin());\n  if (!it->selected || it->tag != 2) return 1;\n  rows.emplace_front().key = 8;\n  return rows.front().key != 8 || rows.front().tag != 2 || !rows.front().selected;\n}\n",
      "source_sha256": "8cc6a55afba391abde5ab22f96dafcd95dd76a9c696ed98c010a901df5109ca1"
    },
    {
      "name": "list-record-dependent-default-aggregate-input",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nstruct Entry { int first = 3; int second = first + 4; };\nint main() {\n  Entry source[]{{9}, {}};\n  std::list<Entry> rows(source, source + 2);\n  return rows.front().second != 13 || rows.back().second != 7;\n}\n",
      "source_sha256": "c9c260df41c6085da4840cf7f196251bc31a0f6aebe11d214222cb3648a06292"
    },
    {
      "name": "list-record-integral-default-sort-result",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nstruct Entry {\n  int key;\n  int id;\n  long operator<(const Entry& other) const { return key < other.key; }\n};\nint main() {\n  std::list<Entry> values{{3, 4}, {1, 2}, {1, 7}};\n  auto last = values.begin();\n  values.sort();\n  auto it = values.begin();\n  if (it->id != 2 || (++it)->id != 7) return 1;\n  return ++it != last || it->id != 4;\n}\n",
      "source_sha256": "4e93ab4c9318dc20be5b691b071a77370e9ea57e84cffed4e1bef1c81e807315"
    },
    {
      "name": "forward-list-record-integral-unique-result",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nstruct Entry {\n  int key;\n  int id;\n  unsigned char operator==(const Entry& other) const { return key == other.key; }\n};\nint main() {\n  std::forward_list<Entry> values{{2, 5}, {2, 6}, {3, 7}, {3, 8}};\n  values.unique();\n  auto it = values.begin();\n  if (it->id != 5 || (++it)->id != 7) return 1;\n  return ++it != values.end();\n}\n",
      "source_sha256": "d940341ff997b402f12ea13f7700065a7bc3d4a45e90701b381371b3531108c4"
    },
    {
      "name": "list-record-floating-comparison-result-guard",
