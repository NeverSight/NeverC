  "source_cases": [
    {
      "name": "variant-equality-matching-and-different-live-alternatives",
      "source": "#include <variant>\nint main() {\n  std::variant<short, int> a(std::in_place_index<0>, short(-3));\n  std::variant<short, int> b(std::in_place_index<0>, short(-3));\n  if (!(a == b) || a != b) return 1;\n  b.emplace<0>(short(-4));\n  if (a == b || !(a != b)) return 2;\n  b.emplace<1>(-3);\n  if (a == b || !(a != b)) return 3;\n  a.emplace<1>(-3);\n  return !(a == b) || a != b;\n}\n",
      "expected": "accept",
      "source_sha256": "99851341a77e15279e94f6343a2c0ebbc92ff332d21be3b830e944d6f2d645d6",
      "public_header": "variant",
      "kind": "cpp17-operation"
    },
    {
      "name": "variant-equality-duplicate-types-retain-index",
      "source": "#include <variant>\nint main() {\n  std::variant<int, int> a(std::in_place_index<0>, 42);\n  const std::variant<int, int> b(std::in_place_index<1>, 42);\n  if (std::operator==(a, b) || !std::operator!=(a, b)) return 1;\n  a.emplace<1>(42);\n  return !std::operator==(a, b) || std::operator!=(a, b);\n}\n",
      "expected": "accept",
      "source_sha256": "fa8d0a50443938931418be81035318b9307bcf7dea6012926ccd35f1c443694a",
      "public_header": "variant",
      "kind": "cpp17-operation"
    },
    {
      "name": "variant-equality-aliased-operands-evaluate-once",
      "source": "#include <variant>\nusing Value = std::variant<short, int>;\nint left_calls, right_calls;\nconst Value& left(const Value& v) { ++left_calls; return v; }\nconst Value& right(const Value& v) { ++right_calls; return v; }\nint main() {\n  const Value v(std::in_place_index<1>, 9);\n  const Value w(std::in_place_index<1>, 8);\n  if (!(left(v) == right(v))) return 1;\n  if (!(left(v) != right(w))) return 2;\n  return left_calls != 2 || right_calls != 2;\n}\n",
      "expected": "accept",
      "source_sha256": "6a7b9219c593a5a77cf13ebf7cf62c2a8a3396fa0c7580dda03bd9d44c8368c9",
      "public_header": "variant",
      "kind": "cpp17-operation"
    },
