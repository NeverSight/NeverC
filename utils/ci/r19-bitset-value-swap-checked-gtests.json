    {
      "name": "bitset-value-swap-self-alias-and-evaluation",
      "source": "#include <bitset>\n#include <utility>\nusing Bits = std::bitset<65>;\nstatic unsigned left_calls, right_calls;\nBits& left(Bits& value) { ++left_calls; return value; }\nBits& right(Bits& value) { ++right_calls; return value; }\nint main() {\n  Bits value(1);\n  value.set(64);\n  std::swap(left(value), right(value));\n  return value.count() != 2 || !value.test(0) || !value.test(64) ||\n         left_calls != 1 || right_calls != 1;\n}\n",
      "source_sha256": "66a3448978dc6a3ca62eb21883e4d7a53237d80517623da45c3031f89e122520",
      "public_header": "bitset",
      "expected": "accept",
      "kind": "bitset-value-swap-operations"
    },
    {
      "name": "bitset-value-swap-existing-proxy",
      "source": "#include <bitset>\n#include <utility>\nint main() {\n  std::bitset<70> a, b;\n  a.set(65);\n  b.set(64);\n  auto bit = a[65];\n  std::swap(a, b);\n  if (bit || !b.test(65)) return 1;\n  bit.flip();\n  return !a.test(65) || !a.test(64) || !b.test(65) || b.test(64);\n}\n",
      "source_sha256": "3c5e043b373742f2594ea107e0c6bd69e0efd909bcab068aab6462fd6b1a9e98",
      "public_header": "bitset",
      "expected": "accept",
      "kind": "bitset-value-swap-operations"
    },
