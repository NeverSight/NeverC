      "source": "#include <bitset>\n#include <utility>\nint main() {\n  std::bitset<65> a(1), b(2);\n  b.set(64);\n  std::swap<std::bitset<65>>(a, b);\n  return a.count() != 2 || !a.test(64) || !a.test(1) || b.count() != 1 || !b.test(0);\n}\n",
      "source_sha256": "78b59e0a9290c60cbc547d0b044254e1ea88de22489d60c126c859d18972d98b",
