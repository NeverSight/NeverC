    },
    {
      "name": "forward-list-assign-converting-range-reuses-and-extends-nodes",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  const short source[] = {-31, 36, 73};\n  std::forward_list<int> list{9, 6};\n  auto first = list.begin();\n  auto second = first;\n  ++second;\n  list.assign(source, source + 3);\n  auto item = list.begin();\n  if (item != first || *item++ != -31 || item != second || *item++ != 36)\n    return 1;\n  return *item++ != 73 || item != list.end();\n}\n",
      "source_sha256": "0167ac405b1311614647f7ae3d3f687a745375b17c47a28db1ce3009489dc66f",
      "public_header": "forward_list",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-insert-converting-const-long-range",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  const long source[] = {-31L, 3L, 81L, -99L};\n  std::forward_list<int> list{5, 6};\n  auto result = list.insert_after(list.cbegin(), source, source + 3);\n  auto item = list.begin();\n  if (*item++ != 5 || *item++ != -31 || *item++ != 3 || &*item != &*result)\n    return 1;\n  return *item++ != 81 || *item++ != 6 || item != list.end();\n}\n",
      "source_sha256": "2913d2e031e54a95ca4cf97fcd51fe96f959ae3b3c18d222b9c2eced73b37758",
      "public_header": "forward_list",
      "kind": "cpp17-operation"
    },
