      "name": "variant-emplace-index-and-reference",
      "source": "#include <variant>\nint main() {\n  std::variant<int, long> value(std::in_place_index<1>, 29L);\n  int& slot = value.emplace<0>(12);\n  slot += 9;\n  auto* item = std::get_if<0>(&value);\n  return value.index() != 0 || std::holds_alternative<long>(value) ||\n         item != &slot || *item != 21;\n}\n",
      "expected": "accept",
      "source_sha256": "6a318398478c220cf1e68ce636bab5cd3d0f696996f90bc328eae5c53f40b0d9",
      "public_header": "variant",
      "kind": "variant-runtime-control"
    },
    {
      "name": "variant-emplace-type-and-repeated-value",
      "source": "#include <variant>\nint main() {\n  std::variant<int, long> value;\n  const long source = 37;\n  value.emplace<long>(source) += 5;\n  auto* item = std::get_if<long>(&value);\n  if (!item || *item != 42)\n    return 1;\n  long& slot = value.emplace<long>(9L);\n  return value.index() != 1 || std::get_if<long>(&value) != &slot || slot != 9L;\n}\n",
      "expected": "accept",
      "source_sha256": "e8fe5df45180a5ead0513da21aa5ab6cdb7835da5b70076a3ccc625f2ad2c468",
