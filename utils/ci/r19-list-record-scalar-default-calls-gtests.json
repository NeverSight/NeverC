  "source_cases": [
    {
      "name": "list-record-default-call-scalar-earlier-field",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nint calls;\nint offset(int amount) { return amount + ++calls; }\nint tag(int id, int code) { return id * 10 + code; }\nstruct Entry { int id = offset(3); int checksum = tag(id, 5); };\nint main() {\n  std::list<Entry> rows(0);\n  if (calls != 0) return 1;\n  rows.resize(2);\n  auto first = rows.begin();\n  if (calls != 2 || first->id != 4 || first->checksum != 45 || rows.back().checksum != 55) return 1;\n  rows.emplace_back();\n  return calls != 3 || first != rows.begin() || rows.back().checksum != 65;\n}\n",
      "source_sha256": "b1489aa23a5727726855a4871fea5d4f6ac8bb776b9b83205db3091b97d08eb2"
    },
    {
      "name": "forward-list-record-default-call-nested-scalar",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nint calls;\nint offset(int amount) { return amount + ++calls; }\nint tag(int id, bool odd = true) { return id * 10 + odd; }\nstruct Entry { int checksum = tag(offset(2)); };\nint main() {\n  std::forward_list<Entry> rows(2);\n  auto first = rows.begin();\n  auto second = first;\n  ++second;\n  if (calls != 2 || first->checksum != 31 || second->checksum != 41) return 1;\n  rows.resize(2);\n  auto third = rows.emplace_after(second);\n  return calls != 3 || third->checksum != 51 || first != rows.begin();\n}\n",
      "source_sha256": "bde9cb826eb452013e8b4a5b977ed5e1aa030f13f4f42904ca4cae1a02fef4b1"
    },
    {
      "name": "list-record-default-call-floating-scalar",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nint calls;\ndouble measure(double base = 1.5) { return base * ++calls; }\nstruct Entry { double value = measure(); double doubled = measure(value); };\nint main() {\n  std::list<Entry> rows(2);\n  auto first = rows.begin();\n  if (calls != 4 || first->value != 1.5 || first->doubled != 3.0 ||\n      rows.back().value != 4.5 || rows.back().doubled != 18.0) return 1;\n  rows.resize(1);\n  return calls != 4 || first != rows.begin() || rows.back().doubled != 3.0;\n}\n",
      "source_sha256": "6de9e79108d5dd71c4f655015decab55cf94af15e1b17d6f57160356948d63e0"
    },
    {
      "name": "list-record-default-call-reference-argument-guard",
      "section": "list",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source": "#include <list>\nint change(int& value) { return ++value; }\nstruct Entry { int id = 1; int checksum = change(id); };\nint main() {\n  std::list<Entry> rows(1);\n  return rows.front().id != 2 || rows.front().checksum != 2;\n}\n",
      "source_sha256": "ddc72e475277fe06d450dc83a9cfebd5363ea930bb4b9398644e70ae19885cf7"
    },
    {
      "name": "forward-list-record-default-call-nonliteral-default-guard",
      "section": "forward_list",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source": "#include <forward_list>\nint calls;\nint seed() { return ++calls; }\nint tag(int value = seed()) { return value; }\nstruct Entry { int checksum = tag(); };\nint main() {\n  std::forward_list<Entry> rows(1);\n  return rows.front().checksum != 1 || calls != 1;\n}\n",
      "source_sha256": "0663bdd2b8cbeac0900d34bf62adefbf3366971bfc21ca859343b53c3dfc96d5"
