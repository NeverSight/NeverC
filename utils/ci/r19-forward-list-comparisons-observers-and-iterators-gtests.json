  "source_cases": [
    {
      "name": "forward-list-equality-uses-values",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  const std::forward_list<int> one{3, 5, -7};\n  std::forward_list<int> two{3, 5, -7};\n  if (&one.front() == &two.front() || !(one == two) || one != two)\n    return 1;\n  ++two.front();\n  return one == two || !(one != two);\n}\n",
      "public_header": "forward_list",
      "source_sha256": "960e15a01beacf5148fd5e5701f28b97b857331e5aa114c8f1c2641b7ffc8140",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-equality-distinguishes-prefix-and-empty",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  std::forward_list<int> empty, another;\n  std::forward_list<int> short_list{2};\n  std::forward_list<int> long_list{2, 3};\n  if (!(empty == another) || empty != another || empty == short_list || short_list == empty)\n    return 1;\n  return short_list == long_list || long_list == short_list ||\n      !(short_list != long_list) || !(long_list != short_list);\n}\n",
      "public_header": "forward_list",
      "source_sha256": "f8565c05c267f7fd1cbdf7b5d9fb394fc97dc54f6cd3cae325f8d7de3743de9d",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-equality-evaluates-both-operands-once",
      "expected": "accept",
      "source": "#include <forward_list>\nusing List = std::forward_list<int>;\nconst List &observe(const List &list, int &count) {\n  ++count;\n  return list;\n}\nint main() {\n  List left{3, 5}, right{3, 5};\n  int a = 0, b = 0;\n  return !(observe(left, a) == observe(right, b)) || a != 1 || b != 1;\n}\n",
      "public_header": "forward_list",
      "source_sha256": "5b1c51b7e7a63ca2b0fef222412ed241155ba0e248ac59788d9c600c81dcc3a1",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-ordered-comparison-guard",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  std::forward_list<int> left{3}, right{5};\n  return !(left < right);\n}\n",
      "public_header": "forward_list",
      "source_sha256": "17dbdc17882d2f7c63299ec8f64fd59dd2a25e4c06b09f468819d0dd4495f234",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-order-uses-the-first-signed-difference",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  const std::forward_list<int> left{3, -5, 11};\n  const std::forward_list<int> right{3, 5, -11};\n  return !(left < right) || right < left || !(right > left) ||\n      !(left <= right) || !(right >= left) || left >= right || right <= left;\n}\n",
      "public_header": "forward_list",
      "source_sha256": "69f620990954f5111671533d20145cdd776a2b51164d50385f79c8ad2f688904",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-order-recognizes-prefixes-and-empty-owners",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  std::forward_list<int> empty, short_list{3, 5}, long_list{3, 5, -7};\n  if (!(empty < short_list) || !(short_list < long_list) || !(long_list > short_list))\n    return 1;\n  return short_list < empty || long_list < short_list || empty < empty || !(empty <= empty);\n}\n",
      "public_header": "forward_list",
      "source_sha256": "7a4e4392a6333527cc76d21f02148f53b80fcab075b406cfab4b0442a957d571",
      "kind": "cpp17-operation"
