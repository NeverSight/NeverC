  "source_cases": [
    {
      "name": "list-record-member-lexicographic-sort",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nstruct Entry {\n  int rank;\n  int tag;\n  int value;\n  bool operator<(const Entry& other) const {\n    return rank < other.rank || (rank == other.rank && tag < other.tag);\n  }\n};\nint main() {\n  std::list<Entry> values{{4, 1, 12}, {2, 8, 6}, {2, 4, 5}, {2, 4, 3}};\n  auto retained = values.begin();\n  values.sort();\n  auto it = values.begin();\n  if (it->value != 5) return 1;\n  ++it;\n  if (it->value != 3) return 2;\n  ++it;\n  if (it->value != 6) return 3;\n  ++it;\n  return it != retained || it->value != 12;\n}\n",
      "source_sha256": "39116e43a3c54b9f3db8cff9743383186859399231c2dbb23724e4978bae6c68"
    },
    {
      "name": "forward-list-record-by-value-stable-merge",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nstruct Row { short key; int marks[2]; };\nbool before(Row left, Row right) { return left.key < right.key; }\nint main() {\n  std::forward_list<Row> left{{1, {5, 7}}, {3, {6, 8}}};\n  std::forward_list<Row> right{{1, {2, 9}}, {4, {3, 10}}};\n  auto saved = right.begin();\n  left.merge(right, &before);\n  auto it = left.begin();\n  if (!right.empty() || it->marks[1] != 7) return 1;\n  ++it;\n  if (it != saved || it->marks[1] != 9) return 2;\n  ++it;\n  return it->key != 3 || it->marks[0] != 6;\n}\n",
      "source_sha256": "14fcff73edd83a4f22d4b3ce39ad6074f8c92d2fa85131f26a8deccccc583d80"
    },
    {
      "name": "list-record-by-value-descending-sort",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nstruct Row { long key; char value; };\nbool after(Row left, Row right) { return left.key > right.key; }\nint main() {\n  std::list<Row> rows{{3, 8}, {5, 4}, {3, 9}};\n  auto first = rows.begin();\n  rows.sort(&after);\n  auto it = rows.begin();\n  if (it->key != 5) return 1;\n  ++it;\n  return it != first || it->value != 8 || rows.back().value != 9;\n}\n",
      "source_sha256": "514469bea681a3e927d7389234f7f2b620d13c6a7dcc9a45f8b5472309153e26"
    },
    {
      "name": "list-record-effectful-member-order-guard",
      "section": "list",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source": "#include <list>\nint comparisons;\nstruct Entry {\n  int rank;\n  bool operator<(const Entry& other) const {\n    return ++comparisons && rank < other.rank;\n  }\n};\nint main() {\n  std::list<Entry> values{{4}, {2}};\n  values.sort();\n  return values.front().rank != 2;\n}\n",
      "source_sha256": "575ab6a1c977009c9c86dfe762e0a50cfda3e7082c7a2b3e77e35f56211b5298"
    },
    {
      "name": "list-record-by-value-mismatched-field-guard",
      "section": "list",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source": "#include <list>\nstruct Row { int key; int tag; };\nbool before(Row left, Row right) { return left.key < right.tag; }\nint main() {\n  std::list<Row> rows{{2, 6}, {1, 4}};\n  rows.sort(&before);\n  return rows.empty();\n}\n",
      "source_sha256": "2c05e8790df10027a92d67aa2498d675999b33550e04b4bb9d7d9b61c48e3c7d"
    },
    {
      "name": "forward-list-record-by-value-effectful-copy-guard",
      "section": "forward_list",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source": "#include <forward_list>\nint copies;\nstruct Row {\n  int key;\n  Row(int value) : key(value) {}\n  Row(const Row& other) : key(other.key) { ++copies; }\n};\nbool before(Row left, Row right) { return left.key < right.key; }\nint main() {\n  std::forward_list<Row> rows{{2}, {1}};\n  rows.sort(&before);\n  return copies < 2;\n}\n",
      "source_sha256": "15ae60affc88b99e098b1a03d69f062cf5ecfc1073f5ce631c96c8bdf2d99621"
    },
    {
      "name": "list-record-by-value-volatile-parameter-guard",
      "section": "list",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source": "#include <list>\nstruct Row { int key; };\nbool before(volatile Row left, Row right) { return left.key < right.key; }\nint main() {\n  std::list<Row> rows{{2}, {1}};\n  rows.sort(&before);\n  return rows.front().key != 1;\n}\n",
      "source_sha256": "02c185c91648b502c9f2a9f73f9c14177ac293be7e974f59d4d0cf84eafee7ab"
    }
  ],
