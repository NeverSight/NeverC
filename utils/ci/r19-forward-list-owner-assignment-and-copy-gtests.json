  "source_cases": [
    {
      "name": "forward-list-move-assignment-retains-nodes",
      "expected": "accept",
      "source": "#include <forward_list>\n#include <utility>\n\nint main() {\n  std::forward_list<int> input{3, 4};\n  std::forward_list<int> output{9, 8};\n  const int *first = &input.front();\n  auto &assigned = (output = std::move(input));\n  if (&assigned != &output || &output.front() != first || !input.empty())\n    return 1;\n  auto cursor = output.begin();\n  ++cursor;\n  if (*cursor != 4)\n    return 2;\n  input.push_front(7);\n  return input.front() != 7 || output.front() != 3;\n}\n",
      "public_header": "forward_list",
      "source_sha256": "ec569a4d95c47ffe66d85e5a2627a6a4611c0751f77fc9a3354b48960ab6f1ea",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-move-assignment-evaluation-order",
      "expected": "accept",
      "source": "#include <forward_list>\n#include <utility>\n\nusing List = std::forward_list<int>;\n\nList &mark(List &owner, int &trace, int digit) {\n  trace = trace * 10 + digit;\n  return owner;\n}\n\nint main() {\n  List from{4};\n  List into{5};\n  int trace = 0;\n  mark(into, trace, 2) = std::move(mark(from, trace, 1));\n  if (trace != 12 || !from.empty() || into.front() != 4)\n    return 1;\n  trace = 0;\n  mark(from, trace, 2).operator=(std::move(mark(into, trace, 1)));\n  return trace != 21 || !into.empty() || from.front() != 4;\n}\n",
      "public_header": "forward_list",
      "source_sha256": "41ecb63d0caed466eb6d03902bd855222367d5124c5901348b9560c9e70971fa",
      "kind": "cpp17-operation"
    },
