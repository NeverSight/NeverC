    },
    {
      "name": "bitset-shift-single-word",
      "kind": "native-reference-only",
      "expected": "accept",
      "source": "#include <bitset>\nint main(){std::bitset<1> one;one.set();if((one<<0)!=one||(one>>0)!=one||(one<<1).any()||(one>>1).any())return 1;\nstd::bitset<63> x;x.set(0).set(62);auto left=x<<1, right=x>>1;\nif(left.count()!=1||!left.test(1)||right.count()!=1||!right.test(61))return 2;\nstd::bitset<64> y;y.set(0).set(63);return (y<<63).count()!=1||!(y<<63).test(63)||(y>>63).count()!=1||!(y>>63).test(0)||(y<<64).any()||(y>>64).any();}\n",
      "source_sha256": "4e7a209693df8d198b19794efba18f742af1353527158d8ce8508e7cfb0b3d4b",
      "private_support_verified": false,
