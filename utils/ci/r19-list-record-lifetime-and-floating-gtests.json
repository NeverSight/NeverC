      "kind": "cpp17-negative",
      "source_sha256": "869f23cb4420318537dc14d9b96c46ae520b6f4928189a48a13c73aaa1d09047"
    },
    {
      "name": "list-record-effectful-float-comparison-result-guard",
      "section": "list",
      "expected": "reject",
