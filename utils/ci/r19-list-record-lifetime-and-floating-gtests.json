      "kind": "cpp17-operation",
      "source_sha256": "fd430cd2968a825ba206b63373a78834ae31967ec930d7b79c4bd60a90d68672"
    },
    {
      "name": "list-record-long-double-comparison-result-guard",
      "section": "list",
      "expected": "reject",
