  "source_cases": [
    {
      "name": "list-record-dependent-default-and-destruction",
      "section": "list",
      "expected": "accept",
      "source": "#include <list>\nint seen;\nstruct Entry {\n  int seed = 3;\n  int tag = seed + 4;\n  ~Entry() noexcept { seen = seen * 10 + tag; }\n};\nint main() {\n  {\n    std::list<Entry> rows(2);\n    rows.front().tag = 8;\n    rows.pop_front();\n    if (seen != 8 || rows.front().tag != 7) return 1;\n  }\n  return seen != 87;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "18620767e5d47b5997bc13050e649092e7e2fb5ab24cd158207048bb79053133"
    },
    {
      "name": "forward-list-record-default-call-and-destruction",
      "section": "forward_list",
      "expected": "accept",
      "source": "#include <forward_list>\nint calls, released;\nint next() { return ++calls; }\nstruct Entry {\n  int key = next();\n  int tag = key + 3;\n  ~Entry() noexcept { released += tag; }\n};\nint main() {\n  std::forward_list<Entry> rows(1);\n  auto first = rows.begin();\n  rows.resize(3);\n  if (calls != 3 || first != rows.begin() || first->tag != 4) return 1;\n  rows.pop_front();\n  if (released != 4 || rows.front().tag != 5) return 1;\n  rows.clear();\n  return calls != 3 || released != 15 || !rows.empty();\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "486355e3c0afa6eed11cccafdd270772b8cdd93af78db3e8e17a6935be25e0ca"
    },
    {
      "name": "list-record-default-emplacement-splice-and-destruction",
      "section": "list",
      "expected": "accept",
      "source": "#include <list>\nint calls, released;\nint next() { return ++calls; }\nstruct Entry {\n  int tag = next() + 4;\n  ~Entry() noexcept { released += tag; }\n};\nint main() {\n  std::list<Entry> left, right;\n  auto& item = left.emplace_back();\n  right.splice(right.end(), left, left.begin());\n  if (!left.empty() || &right.front() != &item || item.tag != 5 || calls != 1 || released) return 1;\n  right.erase(right.begin());\n  return released != 5 || calls != 1 || !right.empty();\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "6b1cb481f1ec914cdbd6e2cefd97db1c989cd9508a4d275d571330588b8eafcb"
    },
    {
      "name": "forward-list-record-default-and-nested-destruction-order",
      "section": "forward_list",
      "expected": "accept",
      "source": "#include <forward_list>\nint order;\nstruct Child {\n  int id;\n  ~Child() noexcept { order = order * 10 + id; }\n};\nstruct Entry {\n  int tag = 3;\n  Child first;\n  Child second;\n  ~Entry() noexcept { order = order * 10 + tag; }\n};\nint main() {\n  std::forward_list<Entry> rows(1);\n  rows.front().first.id = 1;\n  rows.front().second.id = 2;\n  rows.clear();\n  return order != 321;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "90d654a5e0cb4b1529a77ec3cdd2310568fbebaac652e8d30214dd24376b082d"
    },
    {
      "name": "list-record-float-default-sort",
      "section": "list",
      "expected": "accept",
      "source": "#include <list>\nstruct Entry {\n  int key;\n  int id;\n  float operator<(const Entry& other) const { return key < other.key; }\n};\nint main() {\n  std::list<Entry> rows{{4, 0}, {2, 1}, {2, 2}, {1, 3}};\n  const auto moved = rows.begin();\n  rows.sort();\n  auto item = rows.begin();\n  if (item->id != 3 || (++item)->id != 1 || (++item)->id != 2) return 1;\n  return ++item != moved || item->id != 0;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "ca1acc7daa9e41e157b1a097a718f4d10134d61dcd917caf349bd30b01adf2d0"
    },
    {
      "name": "forward-list-record-double-default-unique",
      "section": "forward_list",
      "expected": "accept",
      "source": "#include <forward_list>\nstruct Entry {\n  int key;\n  int id;\n  double operator==(const Entry& other) const { return key == other.key; }\n};\nint main() {\n  std::forward_list<Entry> rows{{2, 0}, {2, 1}, {3, 2}, {3, 3}};\n  auto first = rows.begin();\n  auto third = first;\n  ++third;\n  ++third;\n  rows.unique();\n  auto after = rows.begin();\n  ++after;\n  return rows.begin() != first || after != third || (++after) != rows.end();\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "304bb1f5b59175d3772096f8b45627e96c7364c003084182b6543f4d0ca6ee9c"
    },
    {
      "name": "list-record-double-removal-result",
      "section": "list",
      "expected": "accept",
      "source": "#include <list>\nstruct Entry {\n  int key;\n  double operator==(const Entry& other) const { return key == other.key; }\n};\nint main() {\n  std::list<Entry> rows{{1}, {2}, {3}, {2}};\n  auto first = rows.begin();\n  rows.remove(Entry{2});\n  return rows.size() != 2 || rows.begin() != first || rows.back().key != 3;\n}\n",
      "kind": "cpp17-operation",
