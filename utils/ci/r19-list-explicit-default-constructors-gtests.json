  "source_cases": [
    {
      "name": "list-direct-record-default-constructor",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nint sequence;\nstruct Entry {\n  int first, second;\n  explicit Entry() noexcept : first(++sequence), second(first + 10) { second += 2; }\n};\nint main() {\n  std::list<Entry> rows(2);\n  if (sequence != 2 || rows.front().first != 1 || rows.back().second != 14) return 1;\n  rows.resize(3);\n  return sequence != 3 || rows.back().first != 3 || rows.back().second != 15;\n}\n",
      "source_sha256": "e32e42394b6fb3a0539c603f4be68586943c78484f6e6ae360a75521176bcd96"
    },
    {
      "name": "forward-list-nested-user-default-constructor",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nint sequence, released;\nint next() { return ++sequence; }\nstruct Leaf {\n  int ticket;\n  Leaf() noexcept : ticket(++sequence) {}\n  ~Leaf() noexcept { released = released * 10 + ticket; }\n};\nstruct Entry { int before = next(); Leaf fields[2]; int after = next(); };\nint main() {\n  std::forward_list<Entry> rows;\n  auto& row = rows.emplace_front();\n  if (sequence != 4 || row.before != 1 || row.fields[0].ticket != 2 ||\n      row.fields[1].ticket != 3 || row.after != 4) return 1;\n  rows.clear();\n  return released != 32;\n}\n",
      "source_sha256": "cd144fd7d2fd5dea0386a09c35353838988aaa484ec9e97b560f8044d33e7463"
    },
    {
      "name": "forward-list-user-default-constructor-fill-copy",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nint sequence;\nstruct Entry {\n  int value;\n  Entry() noexcept;\n};\nEntry::Entry() noexcept : value(++sequence) {}\nint main() {\n  Entry seed;\n  std::forward_list<Entry> rows(2, seed);\n  if (sequence != 1 || rows.front().value != 1) return 1;\n  rows.emplace_front();\n  return sequence != 2 || rows.front().value != 2;\n}\n",
      "source_sha256": "3d29a9a8958f813e3c88dbcd7a4a8ee5b4c05ace2c5db4195396b6bece6dc206"
    },
    {
      "name": "list-user-default-constructor-destruction",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nint sequence, released;\nstruct Entry {\n  int value;\n  Entry() noexcept : value(++sequence) {}\n  ~Entry() noexcept { released = released * 10 + value; }\n};\nint main() {\n  std::list<Entry> rows;\n  auto& first = rows.emplace_back();\n  auto& second = rows.emplace_front();\n  if (first.value != 1 || second.value != 2 || released) return 1;\n  rows.pop_front();\n  if (released != 2) return 1;\n  rows.clear();\n  return released != 21;\n}\n",
      "source_sha256": "a1061deecb3acdd1ebf18fbd6b6c9f187f4911abd8d5db529c515c3e0aa07859"
    },
    {
      "name": "list-user-default-constructor-parameter-guard",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nstruct Entry { int value; explicit Entry(int n = 7) noexcept : value(n) {} };\nint main() {\n  std::list<Entry> rows(1);\n  return rows.front().value != 7;\n}\n",
      "source_sha256": "2583119d67c6b09b22866fb4e3b013ce252d33818333e0e233c2494b4c96fd0f"
