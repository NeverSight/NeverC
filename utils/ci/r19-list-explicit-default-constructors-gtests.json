    {
      "name": "forward-list-user-default-constructor-move-guard",
      "section": "forward_list",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source": "#include <forward_list>\nstruct Entry {\n  int value;\n  Entry() noexcept : value(7) {}\n  Entry(const Entry&) = default;\n  Entry(Entry&& other) noexcept : value(other.value + 1) {}\n};\nint main() {\n  std::forward_list<Entry> rows(1);\n  return rows.front().value != 7;\n}\n",
      "source_sha256": "e138a867a42cb31044730e96e09e6f3e28f84bc3ebfd5db5ad910fde3e2a3339"
