  "native_cases": [
    {
      "name": "bind-lvalue-captures-after-argument-effects",
      "source": "#include <functional>\nint first(int, int) { return -1; }\nint second(int a, int b) { return 100 + 10 * a + b; }\nint &change(int (*&pointer)(int, int), int &value) {\n  pointer = &second;\n  value = 3;\n  return value;\n}\nint main() {\n  int (*pointer)(int, int) = &first;\n  int value = 1;\n  auto f = std::bind(pointer, change(pointer, value), value);\n  if (f() != 133) return 1;\n  value = 9;\n  pointer = &first;\n  return f() != 133;\n}\n",
      "source_sha256": "36e239740481446b2397da1316fb807dd283b7c502f8f39c9d6e7fb3e2abc9f9"
    },
    {
      "name": "bind-stored-state-and-rvalue-receiver",
      "source": "#include <functional>\n#include <type_traits>\n#include <utility>\nint increment(int &value) { return ++value; }\nint main() {\n  auto f = std::bind(&increment, 4);\n  auto copy = f;\n  using F = decltype(f);\n  static_assert(!std::is_invocable<const F &>::value, \"const stored value cannot bind mutable int reference\");\n  if (f() != 5 || std::move(f)() != 6 || copy() != 5) return 1;\n  return f() != 7;\n}\n",
      "source_sha256": "967ec76e1957b8b7d653734291d4d30a7cb24b906748e67d5ae57fff030eba15"
    }
  ],
  "metadata_cases": [
    {
      "name": "bind-layout-ordinary-two",
      "source": "#include <functional>\nint add(int a, int b) { return a+b; }\nusing Binding = decltype(std::bind(&add, 1, 2));\nstatic_assert(sizeof(Binding)>0 && alignof(Binding)>0, \"layout\");\nint main() { auto f=std::bind(&add, 1, 2); const auto c=f; return f()+c()-6; }\n",
      "source_sha256": "30f9a7152ee37666c555f3396b305a67a65fdc41ac1adca67154248f1724d4cf"
    },
    {
      "name": "bind-layout-noexcept-two",
      "source": "#include <functional>\n#include <type_traits>\nint add(int a, int b) noexcept { return a+b; }\nusing Binding = decltype(std::bind(&add, 1, 2));\nstatic_assert(sizeof(Binding)>0 && alignof(Binding)>0, \"layout\");\nstatic_assert(std::is_bind_expression<Binding>::value, \"bind query\");\nstatic_assert(std::is_invocable<const Binding &>::value, \"const invocation\");\nstatic_assert(!noexcept(std::declval<Binding &>()()), \"pinned bind operator is not noexcept\");\nint main() { auto f=std::bind(&add, 1, 2); const auto c=f; return f()+c()-6; }\n",
      "source_sha256": "5163e1b45a5d87ec845ae9f00f559f30cd4c11ed11d807f9eb7123d4d71b51de"
    },
    {
      "name": "bind-layout-reference-result",
      "source": "#include <functional>\n#include <type_traits>\nint &identity(int &v) { return v; }\nusing Binding = decltype(std::bind(&identity, std::ref(std::declval<int &>())));\nstatic_assert(sizeof(Binding)>0 && alignof(Binding)>0, \"layout\");\nstatic_assert(std::is_same<decltype(std::declval<const Binding &>()()),int &>::value, \"reference result\");\nint main() { int v=3; auto f=std::bind(&identity,std::ref(v)); const auto c=f; c()=5; return &f()!=&v; }\n",
      "source_sha256": "7fafa4bfa005ce4de8509f2a8ad6a7859753dd440a16292261bc80282c0c1a55"
    },
    {
      "name": "bind-layout-void-pointer",
      "source": "#include <functional>\nvoid store(int *p,int v) { *p=v; }\nusing Binding = decltype(std::bind(&store,static_cast<int *>(nullptr),2));\nstatic_assert(sizeof(Binding)>0 && alignof(Binding)>0, \"layout\");\nint main() { int v=0; auto f=std::bind(&store,&v,2); const auto c=f; f(); c(); return v-2; }\n",
      "source_sha256": "07df761347216e50fc617d6854799fdc80e18ff937041f201382fbefe0df9aa6"
    }
