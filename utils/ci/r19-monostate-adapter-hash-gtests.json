      "name": "monostate-adapter-hash-direct-invoke",
      "expected": "accept",
      "public_header": "variant",
      "kind": "cpp17-operation",
      "source": "#include <functional>\n#include <variant>\nusing M = std::monostate;\nusing H = std::hash<M>;\nint hasher_calls, value_calls;\nconst H& get_hasher(const H& h) { ++hasher_calls; return h; }\nconst M& get_value(const M& m) { ++value_calls; return m; }\nint main() {\n  const H h{};\n  const M m{};\n  if (std::invoke(H{}, m) != 66740831) return 1;\n  if (std::invoke(get_hasher(h), get_value(m)) != 66740831) return 2;\n  return hasher_calls != 1 || value_calls != 1;\n}\n",
      "source_sha256": "4e8afe67703b57fe9b988882827432b3425b2ac9c92e212f60670087de987317"
    },
    {
      "name": "monostate-adapter-hash-tuple-of-references",
      "expected": "accept",
      "public_header": "variant",
      "kind": "cpp17-operation",
      "source": "#include <functional>\n#include <tuple>\n#include <variant>\nusing M = std::monostate;\nusing Args = std::tuple<const M&>;\nint calls;\nconst M& borrow(const M& m) { ++calls; return m; }\nint main() {\n  const M m{};\n  const Args args = std::tie(borrow(m));\n  return std::apply(std::hash<M>{}, args) != 66740831 || calls != 1;\n}\n",
      "source_sha256": "c62def4d2558a10eaff2a868a683aa764f74182b1eed27df401d953ef76a2ed2"
    },
    {
