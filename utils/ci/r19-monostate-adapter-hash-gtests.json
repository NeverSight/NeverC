      "source": "#include <functional>\n#include <variant>\nusing M = std::monostate;\nusing H = std::hash<M>;\nint calls;\nconst M& borrow(const M& m) { ++calls; return m; }\nint main() {\n  H h{};\n  const M m{};\n  auto ref = std::ref(h);\n  auto cref = std::cref(h);\n  return ref(borrow(m)) != 66740831 || cref(borrow(m)) != 66740831 ||\n         calls != 2;\n}\n",
