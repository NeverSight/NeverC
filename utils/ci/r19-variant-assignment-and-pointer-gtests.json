      "source": "#include <variant>\nint main() {\n  using Value = std::variant<int, std::monostate>;\n  Value value{45};\n  Value& result = (value = std::monostate{});\n  return &result != &value || value.index() != 1 || std::get_if<1>(&value) == nullptr;\n}\n",
      "source_sha256": "0f2a37e22acdaca080f9599548c732e35d5046c5181069857435fb093b02d063"
    },
    {
      "name": "variant-monostate-assignment-from-active-alternative",
      "public_header": "variant",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nint main() {\n  using Value = std::variant<int, std::monostate>;\n  Value value{std::in_place_index<1>};\n  const auto* item = std::get_if<1>(&value);\n  if (!item) return 1;\n  value = *item;\n  return value.index() != 1 || std::get_if<1>(&value) != item;\n}\n",
      "source_sha256": "97e9b9d0b12e6dd4c090802656a2a8a938d656b4e01c0fbc098133a19fb7993c"
    },
    {
      "name": "variant-monostate-assignment-obeys-operand-sequencing",
      "public_header": "variant",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing Value = std::variant<int, std::monostate>;\nValue& receiver(Value& value, int& trace) {\n  trace = trace * 10 + 1;\n  return value;\n}\nconst std::monostate& operand(const std::monostate& value, int& trace) {\n  trace = trace * 10 + 2;\n  return value;\n}\nint main() {\n  Value value{5};\n  const std::monostate item{};\n  int trace = 0;\n  receiver(value, trace) = operand(item, trace);\n  if (trace != 21 || value.index() != 1) return 1;\n  trace = 0;\n  receiver(value, trace).operator=(operand(item, trace));\n  return trace != 12 || value.index() != 1;\n}\n",
      "source_sha256": "a980fa70dcc584f279b6fb3939ec52723a5361d770520b4a0981abfa3aedc59b"
    },
    {
      "name": "variant-monostate-assignment-pointer-receiver",
      "public_header": "variant",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing Value = std::variant<int, std::monostate>;\nValue& assign(Value* value, const std::monostate& input) {\n  return value->operator=(input);\n}\nint main() {\n  Value value{6};\n  const std::monostate input{};\n  return &assign(&value, input) != &value || !std::holds_alternative<std::monostate>(value);\n}\n",
      "source_sha256": "f2cd969000be8c01553d7d26c866372e6dbce2b2fba561ae64423a3949af8edd"
    },
    {
      "name": "variant-pointer-equality-distinct-objects-and-null",
      "public_header": "variant",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing Value = std::variant<int, int*>;\nint main() {\n  int left = 3, right = 3;\n  const Value a{&left}, alias{&left}, b{&right}, nil{static_cast<int*>(nullptr)}, scalar{0};\n  return a != alias || !(a == alias) || b == a || nil == a || nil != nil || nil == scalar;\n}\n",
      "source_sha256": "be49a1bd68d94fd0eb6a51452a3b5a8c85a76b225219588f50c7308026c626ff"
    },
    {
      "name": "variant-pointer-equality-compares-the-active-index",
      "public_header": "variant",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing Value = std::variant<short, const int*, const int*>;\nint main() {\n  const int value = 7;\n  const Value a{std::in_place_index<1>, &value};\n  const Value b{std::in_place_index<2>, &value};\n  const Value alias{std::in_place_index<2>, &value};\n  return a == b || !(a != b) || b != alias;\n}\n",
      "source_sha256": "d1b633a0c54b6fa2e85da388bd1b4e17db078afe2d23d638bcc09aac61868ce4"
    },
    {
      "name": "variant-pointer-and-float-equality-preserves-payload-types",
      "public_header": "variant",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing Value = std::variant<float, const int*>;\nbool equal(const Value& a, const Value& b) { return a == b && !(b != a); }\nint main() {\n  const int a = 8, b = 8;\n  const Value first{&a}, alias{&a}, second{&b}, negative{-0.0f}, positive{0.0f};\n  return !equal(first, alias) || equal(first, second) || !equal(negative, positive) || equal(first, positive);\n}\n",
      "source_sha256": "c974e796b50b72dd863f3389ec790992dabb7b79998a81886b5bad653d4c1968"
    },
    {
      "name": "variant-void-pointer-equality",
