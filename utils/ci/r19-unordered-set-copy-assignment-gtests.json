  "source_cases": [
    {
      "name": "unordered-set-copy-assignment-unique-copy-assignment-reuses-destination-buckets",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> target{-5, -7, -11, -13};\n  target.rehash(53);\n  const auto buckets = target.bucket_count();\n  std::unordered_set<int> source{100, 18, 6};\n  source.max_load_factor(2.0f);\n  auto& result = (target = source);\n  return &result != &target || target.size() != 3 || target.count(-5) != 0 || target.count(18) != 1 ||\n         target.bucket_count() != buckets || target.max_load_factor() != source.max_load_factor() ||\n         &*target.find(18) == &*source.find(18);\n}\n",
      "source_sha256": "01e2b63a18450ea5f1ffd6262e3b216423ffd03dd6ea99520abba56c9f78973f",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-copy-assignment-multiset-copy-assignment-groups-colliding-duplicates",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> target{-1, -1};\n  target.rehash(2);\n  std::unordered_multiset<int> source{3, 5, 3, 7, 3, 5};\n  source.max_load_factor(5.0f);\n  target = source;\n  auto range = target.equal_range(3);\n  int groups = 0;\n  for (auto it = range.first; it != range.second; ++it) {\n    if (*it != 3) return 1;\n    ++groups;\n  }\n  target.erase(5);\n  return groups != 3 || target.count(5) != 0 || source.count(5) != 2 || target.count(-1) != 0 ||\n         target.count(7) != 1 || target.max_load_factor() != 5.0f;\n}\n",
      "source_sha256": "8d796d4a7eca2e13ad13d75063896f6501795d92c54ffe0a9693bc6bf5afa243",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-copy-assignment-explicit-copy-assignment-evaluates-receiver-before-source",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Set = std::unordered_set<int>;\nint trace;\nSet* receiver(Set& set) { trace = trace * 10 + 2; return &set; }\nconst Set& input(const Set& set) { trace = trace * 10 + 1; return set; }\nint main() {\n  Set source{19, 29};\n  Set target{23};\n  auto& result = receiver(target)->operator=(input(source));\n  return trace != 21 || &result != &target || target.count(19) != 1 || target.count(23) != 0;\n}\n",
      "source_sha256": "48539263b601f0ee9b8f60172d35a1fbf308291fc0efc5d8a00cfe1d072d10eb",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-copy-assignment-self-copy-preserves-addresses-and-equivalent-ranges",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> values{8, -6, 8, 9};\n  values.rehash(31);\n  const auto buckets = values.bucket_count();\n  const int* stored = &*values.find(-6);\n  const auto& alias = values;\n  values = alias;\n  return values.size() != 4 || values.count(8) != 2 || values.bucket_count() != buckets ||\n         &*values.find(-6) != stored;\n}\n",
      "source_sha256": "0d8226013d306eba80ecd37f3cb186f53fa24f81edcf73db5bd1f27da2417e54",
      "kind": "cpp17-operation"
    },
