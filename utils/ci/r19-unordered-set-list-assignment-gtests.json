  "source_cases": [
    {
      "name": "unordered-set-list-assignment-unique-list-assignment-keeps-buckets-and-load-factor",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> values{-2, -4, -6, -8};\n  values.rehash(31);\n  values.max_load_factor(2.0f);\n  const auto buckets = values.bucket_count();\n  auto& result = (values = {3, 34, 3, 7, 34, 5});\n  return &result != &values || values.size() != 4 || values.count(-2) != 0 ||\n         values.count(3) != 1 || values.count(34) != 1 || values.count(5) != 1 ||\n         values.bucket_count() != buckets || values.max_load_factor() != 2.0f;\n}\n",
      "source_sha256": "91dc9d15824d6b94eac4e9cdceb42cbd2881d26f95febf04333cce3e80153804",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-list-assignment-multi-list-assignment-groups-colliding-duplicates",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> values{-1, -3};\n  values.rehash(2);\n  values.max_load_factor(4.0f);\n  values = {9, 7, 9, 5, 7, 9};\n  auto group = values.equal_range(9);\n  int count = 0;\n  for (auto it = group.first; it != group.second; ++it) {\n    if (*it != 9) return 1;\n    ++count;\n  }\n  return values.size() != 6 || values.count(7) != 2 || values.count(-1) != 0 ||\n         values.count(5) != 1 || count != 3 || values.bucket_count() != 2;\n}\n",
      "source_sha256": "5d2b07da71613296ad42fd1fb758136220a364275daa824f2643e75c7868869f",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-list-assignment-explicit-empty-list-assignment-clears-reserved-storage",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <initializer_list>\n#include <unordered_set>\nint main() {\n  std::unordered_set<int> values{11, 23};\n  values.rehash(31);\n  auto* receiver = &values;\n  auto& result = receiver->operator=(std::initializer_list<int>{});\n  return &result != &values || !values.empty() || values.bucket_count() != 31;\n}\n",
      "source_sha256": "4cf8a1f1ec227eb105a377da51a9ea93868f5e5c526fa62a5804c5371d5ae13f",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-list-assignment-list-assignment-evaluates-braced-input-before-receiver",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Set = std::unordered_set<int>;\nint trace;\nint input(int n) { trace = trace * 10 + n; return n; }\nSet& receiver(Set& set) { trace = trace * 10 + 3; return set; }\nint main() {\n  Set values;\n  receiver(values) = {input(1), input(2)};\n  return trace != 123 || values.size() != 2 || values.count(1) != 1 || values.count(2) != 1;\n}\n",
      "source_sha256": "91dcecc82ae300a47ee39a1c9df518bb7eb4d44565cefe51fe1d8e88459ea048",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-list-assignment-custom-hash-list-assignment",
      "expected": "reject",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nstruct Hash { unsigned long operator()(int value) const { return static_cast<unsigned>(value); } };\nint main() {\n  std::unordered_set<int, Hash> values;\n  values = {2, 2};\n  return values.empty();\n}\n",
      "source_sha256": "f353ede623d7a4b2a7ed18ee70ecbf8336452278ca5aec4e78144c3d0eba014c",
      "kind": "source-body-guard"
    },
    {
      "name": "unordered-set-list-assignment-custom-equality-multi-list-assignment",
      "expected": "reject",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nstruct Equal { bool operator()(int left, int right) const { return left == right; } };\nint main() {\n  std::unordered_multiset<int, std::hash<int>, Equal> values;\n  values = {3, 3};\n  return values.empty();\n}\n",
      "source_sha256": "7341d9d164e6d24b6a9fd56b05f8f18bdb68863bfe2ef25d1420c281471148cf",
      "kind": "source-body-guard"
    },
