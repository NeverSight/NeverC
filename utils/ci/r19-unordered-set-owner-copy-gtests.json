      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> source{8, 8};\n  std::unordered_multiset<int> copy(source, std::allocator<int>{});\n  return copy.count(8) != 2;\n}\n",
      "source_sha256": "f2856bb20efbd88a95e06d80be1a8f1075b42f26986b3a8314fa59936c517385",
      "kind": "cpp17-operation"
