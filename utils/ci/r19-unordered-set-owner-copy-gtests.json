  "source_cases": [
    {
      "name": "unordered-set-owner-copy-unique-const-source-owns-distinct-nodes",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> values{5, 11, -7};\n  values.rehash(29);\n  values.max_load_factor(2.5f);\n  const auto& source = values;\n  std::unordered_set<int> copy(source);\n  return copy.size() != 3 || copy.count(-7) != 1 || copy.bucket_count() != source.bucket_count() ||\n         copy.max_load_factor() != 2.5f || &*copy.find(-7) == &*source.find(-7);\n}\n",
      "source_sha256": "c3864fdeb3caae8a7e4580f23682f648be1f92b585af561b6a98fbe74a7973ea",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-owner-copy-multiset-copy-preserves-counts-and-independent-erase",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> source{8, 8, -3, 8, -3, 4};\n  source.rehash(23);\n  source.max_load_factor(2.0f);\n  const std::unordered_multiset<int> copy(source);\n  auto removed = source.erase(8);\n  return removed != 3 || source.count(8) != 0 || copy.count(8) != 3 || copy.count(-3) != 2 ||\n         copy.bucket_count() != 23 || copy.max_load_factor() != 2.0f;\n}\n",
      "source_sha256": "322299cbea5f328fef07209b0f0e1f331d869e860b8e8e802e238bfd8424a4d3",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-owner-copy-reserved-empty-copy-keeps-bucket-policy",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> source;\n  source.rehash(31);\n  source.max_load_factor(3.5f);\n  std::unordered_multiset<int> copy(source);\n  copy.insert({-1, -1});\n  return !source.empty() || copy.count(-1) != 2 || copy.bucket_count() != source.bucket_count() ||\n         copy.max_load_factor() != 3.5f;\n}\n",
      "source_sha256": "9160a68137553e592a7f9e404bec3e4516a2f3e1a9cc4084c1d361052eedfce8",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-owner-copy-reference-producing-source-evaluated-once",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Set = std::unordered_set<int>;\nint accesses;\nconst Set& input(const Set& values) { ++accesses; return values; }\nint main() {\n  Set values{0, 6, 18};\n  Set copy(input(values));\n  values.clear();\n  return accesses != 1 || !values.empty() || copy.size() != 3 || copy.count(6) != 1;\n}\n",
      "source_sha256": "dce8dd1c320b3a1e48d8b9a730e4dc9ab45a00792e6da36ed9834eaf807d151d",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-owner-copy-explicit-allocator-copy",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> source{1};\n  std::unordered_set<int> copy(source, std::allocator<int>{});\n  return copy.empty();\n}\n",
      "source_sha256": "1dba24a284c29a629caf72a44ba0b72c8865582d940a5de88c6f1fbdabadd0e4",
      "kind": "cpp17-operation"
    },
    {
