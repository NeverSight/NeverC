  "source_cases": [
    {
      "name": "unordered-set-pointer-range-unique-range-inserts-distinct-keys",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  int data[] = {3, 11, 3, -1, 19, 0, 11};\n  std::unordered_set<int> set{11};\n  set.rehash(2);\n  set.insert(data, data + 7);\n  return set.size() != 5 || set.count(3) != 1 || set.count(-1) != 1 || set.count(19) != 1 || set.count(0) != 1;\n}\n",
      "source_sha256": "bdf6fc0105dec6fff60e40b0d3d2c53b7259c659fa4f9a762f8582df7a85104f",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-pointer-range-multiset-const-range-retains-counts",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  const int data[] = {4, 4, 12, 4, 12, -1};\n  std::unordered_multiset<int> bag{4};\n  bag.insert(data, data + 6);\n  return bag.size() != 7 || bag.count(4) != 4 || bag.count(12) != 2 || bag.count(-1) != 1;\n}\n",
      "source_sha256": "c2ea73239d4a086eee30c023e6095f506f51feee2672efc3cd99475b32fc9225",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-pointer-range-empty-range-keeps-buckets-and-values",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  const int data[] = {123, 456, 789};\n  std::unordered_set<int> set{5, 9};\n  const auto buckets = set.bucket_count();\n  set.insert(data + 1, data + 1);\n  return set.size() != 2 || set.count(5) != 1 || set.bucket_count() != buckets;\n}\n",
      "source_sha256": "339cd06ed1c2ab0c519f7148440cad4f816181c912c2974f4631e422198a11a2",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-pointer-range-receiver-and-both-endpoints-evaluated-once",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Bag = std::unordered_multiset<int>;\nint accesses, firsts, lasts;\nint data[] = {7, 7, 8, 8};\nBag& receiver(Bag& bag) { ++accesses; return bag; }\nint* first() { firsts += accesses; return data + 1; }\nint* last() { lasts += accesses; return data + 3; }\nint main() {\n  Bag bag;\n  receiver(bag).insert(first(), last());\n  return accesses != 1 || firsts != 1 || lasts != 1 || bag.size() != 2 ||\n      bag.count(7) != 1 || bag.count(8) != 1;\n}\n",
      "source_sha256": "82555e98178a3fc67fb45d4f8a6c39dd4cbdd03c37d70c52064cff3753aa85df",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-pointer-range-pointer-receiver",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() { const int data[] = {3, 3}; std::unordered_multiset<int> bag; auto* ptr=&bag; ptr->insert(data, data + 2); return bag.empty(); }\n",
      "source_sha256": "649214658a809dfb8f15db45a26b43e7d9a61f6d967958ae148a8900f4d4d103",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-pointer-range-converted-long-range",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() { long data[] = {1L, 2L}; std::unordered_set<int> set; set.insert(data, data + 2); return set.empty(); }\n",
      "source_sha256": "a52bd9eb9a79c68e44c5f98e07440e288667ed4cfd9683bdee7960dbbbbbf482",
      "kind": "cpp17-operation"
    },
