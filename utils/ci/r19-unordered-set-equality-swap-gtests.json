  "source_cases": [
    {
      "name": "unordered-set-equality-swap-unique-equality-ignores-buckets-and-order",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> a{1, -1, 0, 13}, b{13, 0, -1, 1};\n  a.rehash(31);\n  if (!(a == b) || a != b) return 1;\n  b.erase(13);\n  b.insert(14);\n  return a == b || !(a != b);\n}\n",
      "source_sha256": "20854170f1f5ee6261c273a076789b55541baca6714d7863534a82038ee87376",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-equality-swap-multiset-equality-checks-each-multiplicity",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  const std::unordered_multiset<int> a{1, 1, 9, 9, 9, 17};\n  std::unordered_multiset<int> b{9, 1, 9, 17, 9, 1};\n  b.rehash(8);\n  if (a != b || !(a == b)) return 1;\n  b.erase(b.find(9));\n  b.insert(17);\n  if (a == b || !(a != b) || a.size() != b.size()) return 2;\n  b.erase(b.find(17));\n  b.insert(9);\n  return a != b;\n}\n",
      "source_sha256": "cc10f21bedac5648f2c3bdc4b7dee5e9ee1389f236ff090d128b7044cb9fd8cc",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-equality-swap-member-swap-preserves-storage-and-element-addresses",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> left{4, 5}, right;\n  left.rehash(31);\n  left.max_load_factor(.5f);\n  const auto buckets = left.bucket_count();\n  const int* saved = &*left.find(5);\n  left.swap(right);\n  if (!left.empty() || right.count(4) != 1 || &*right.find(5) != saved) return 1;\n  if (right.bucket_count() != buckets || right.max_load_factor() != .5f) return 2;\n  right.swap(right);\n  return right.count(4) != 1 || &*right.find(5) != saved;\n}\n",
      "source_sha256": "1c4dc1b957b20391bf3364d1fa529ba822416676c0007f698e58145b1f5e684b",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-equality-swap-qualified-and-adl-multiset-swap",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Bag = std::unordered_multiset<int>;\nint seen;\nBag& pick(Bag& bag) { ++seen; return bag; }\nint main() {\n  Bag a{7, 7, 8}, b{2, 2};\n  const int* saved = &*a.find(8);\n  std::swap(pick(a), pick(b));\n  if (seen != 2 || a.count(2) != 2 || b.count(7) != 2 || &*b.find(8) != saved) return 1;\n  swap(a, b);\n  return a.count(7) != 2 || &*a.find(8) != saved || b.count(2) != 2;\n}\n",
      "source_sha256": "ec2ddf134e43591cf38dc166e689b760053feb54a8d43aa53eafe30c48aa0d28",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-equality-swap-pointer-member-swap",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() { std::unordered_set<int> a{1}, b{2}; auto* p = &a; p->swap(b); return 0; }\n",
      "source_sha256": "c64f66c538c0af7a2f9b6297d3563707bfdc3a8b616c75375e88dd57576c994f",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-equality-swap-other-key-equality",
