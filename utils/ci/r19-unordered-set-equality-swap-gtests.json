      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() { std::unordered_set<long> a{1L}, b{2L}; return a == b; }\n",
      "source_sha256": "c67d3ba60911ffa55aee62884f73080687d6528e71dfdf2745b59b145bdd00ce",
      "kind": "source-body-guard"
    },
    {
      "name": "unordered-set-equality-swap-custom-policy-equality",
      "expected": "reject",
      "public_header": "unordered_set",
