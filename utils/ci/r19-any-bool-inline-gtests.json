    {
      "name": "any-bool-inline-typed-mutable-pointer",
      "expected": "accept",
      "public_header": "any",
      "kind": "cpp17-operation",
      "source": "#include <any>\nint main() {\n  std::any value{true};\n  auto* flag = std::any_cast<bool>(&value);\n  if (!flag || !*flag || std::any_cast<int>(&value)) return 1;\n  *flag = false;\n  const auto& view = value;\n  auto* result = std::any_cast<const bool>(&view);\n  return !result || *result || std::any_cast<unsigned>(&view) != nullptr;\n}\n",
      "source_sha256": "19a795446b7081f11f8014fd3cbd180dd0ae211c1fd85aed39e8863026f2f4ab"
    },
    {
      "name": "any-bool-inline-factory-emplace-reset",
      "expected": "accept",
      "public_header": "any",
      "kind": "cpp17-operation",
      "source": "#include <any>\nint main() {\n  std::any value = std::make_any<bool>();\n  auto* first = std::any_cast<bool>(&value);\n  if (!first || *first) return 1;\n  bool& stored = value.emplace<bool>(true);\n  if (!stored || !value.has_value()) return 2;\n  value.reset();\n  return value.has_value() || std::any_cast<bool>(&value) != nullptr;\n}\n",
      "source_sha256": "8f00e8099df875775989754363e2158f54cb9afe33b036337ce25fec8bd72568"
    },
    {
      "name": "any-bool-inline-copy-move-and-assignment",
      "expected": "accept",
      "public_header": "any",
      "kind": "cpp17-operation",
      "source": "#include <any>\n#include <utility>\nint main() {\n  std::any left{true};\n  std::any right{7u};\n  left.swap(right);\n  std::any transferred(std::move(right));\n  if (right.has_value() || !std::any_cast<unsigned>(&left)) return 1;\n  const auto* first = std::any_cast<bool>(&transferred);\n  if (!first || !*first) return 2;\n  left = false;\n  transferred = left;\n  const auto* copied = std::any_cast<bool>(&transferred);\n  return !copied || *copied || std::any_cast<unsigned>(&left) != nullptr;\n}\n",
      "source_sha256": "9fff6f3daf6edfab7929440c3580421e796828869c5676488ab9d7977e5c0e15"
    },
