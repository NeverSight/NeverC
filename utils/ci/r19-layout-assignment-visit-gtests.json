      "source": "#include <variant>\nint main() {\n  std::variant<int, long> value(3), other(77L);\n  (value = 34L) = other;\n  auto* item = std::get_if<long>(&value);\n  return value.index() != 1 || !item || *item != 77L || std::get_if<int>(&value);\n}\n",
