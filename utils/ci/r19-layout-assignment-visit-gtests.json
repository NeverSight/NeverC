      "public_header": "variant",
      "kind": "cpp17-operation"
    },
    {
      "name": "variant-value-assignment-same-alternative-reference",
      "source": "#include <variant>\nint main() {\n  std::variant<int, long> value(25L);\n  long* before = std::get_if<long>(&value);\n  const long value_to_assign = 42L;\n  auto& result = (value = value_to_assign);\n  long* after = std::get_if<long>(&result);\n  if (!before || before != after || *after != 42L || &result != &value)\n    return 1;\n  value = *after;\n  return *before != 42L;\n}\n",
      "expected": "accept",
      "source_sha256": "aeb04b9104dc44902f6c48b6ab86b2252cbccebd180c766dfc6e227a6fb41d64",
      "public_header": "variant",
      "kind": "cpp17-operation"
    },
    {
      "name": "variant-value-assignment-assignment-syntax-binding-order",
      "source": "#include <variant>\nusing Value = std::variant<int, long>;\nint order;\nlong next_value = 3;\nlong& input() { order = order * 10 + 1; return next_value; }\nValue& target(Value& value) { order = order * 10 + 2; next_value = 41; return value; }\nint main() {\n  Value value(17);\n  target(value) = input();\n  auto* item = std::get_if<long>(&value);\n  return order != 12 || !item || *item != 41L;\n}\n",
      "expected": "accept",
      "source_sha256": "281dea5f0c091e3fd0cf3973f9a7f094a41cfb37becd2c400450a263b2ab073e",
      "public_header": "variant",
      "kind": "cpp17-operation"
    },
    {
      "name": "variant-value-assignment-explicit-member-binding-order",
      "source": "#include <variant>\nusing Value = std::variant<int, long>;\nint order;\nValue* target(Value& value) { order = order * 10 + 1; return &value; }\nlong input() { order = order * 10 + 2; return 49L; }\nint main() {\n  Value value(4);\n  auto& result = target(value)->operator=(input());\n  auto* item = std::get_if<long>(&result);\n  return order != 12 || &result != &value || !item || *item != 49L;\n}\n",
      "expected": "accept",
      "source_sha256": "08d9d648cbdc960d30b2dab2bba26cc9818c932e6e7864b06af1612c8e6934c3",
      "public_header": "variant",
      "kind": "cpp17-operation"
    },
