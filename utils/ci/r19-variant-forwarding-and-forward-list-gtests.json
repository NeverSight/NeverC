  "source_cases": [
    {
      "name": "variant-visit-source-cast-preserves-live-owner",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <variant>\nusing Value = std::variant<int, short>;\nValue&& forward_value(Value& value) { return static_cast<Value&&>(value); }\nint read(int value) { return value; }\nint main() {\n  Value item(std::in_place_index<1>, short{7});\n  int before = std::visit(read, forward_value(item));\n  item.emplace<0>(11);\n  return before != 7 || std::visit(read, item) != 11;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "a2bfccfbce74210abf08513137f4ff01d36e9f79a5ff501c8adff2687bf134eb"
    },
    {
      "name": "variant-visit-source-cast-borrows-const-owner",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <variant>\nusing Value = std::variant<int, short>;\nconst Value&& view_value(const Value& value) { return static_cast<const Value&&>(value); }\nint read(int value) { return value + 2; }\nint main() {\n  const Value item(std::in_place_index<0>, 13);\n  return std::visit(read, view_value(item)) != 15;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "0636dac193031e3fdf9ff2c67264f12f39da50c2ff50211ca1e0a44d9253fd23"
    },
    {
      "name": "variant-visit-source-cast-and-pinned-move",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <utility>\n#include <variant>\nusing Value = std::variant<int, short>;\nValue&& forward_value(Value& value) { return static_cast<Value&&>((value)); }\nint subtract(int left, int right) { return left - right; }\nint main() {\n  Value left(std::in_place_index<1>, short{17});\n  Value right(5);\n  return std::visit(subtract, forward_value(left), std::move(right)) != 12;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "9b41478a25d871dda45f819aeae6ca742090ec3066de5a50cb30c87ebb9ae6b0"
    },
    {
      "name": "forward-list-move-preserves-node-references",
      "expected": "accept",
      "source": "#include <forward_list>\n#include <utility>\nint main() {\n  std::forward_list<int> source{4, 7};\n  int *first = &source.front();\n  auto current = source.begin();\n  ++current;\n  int *second = &*current;\n  std::forward_list<int> destination(std::move(source));\n  if (!source.empty() || &destination.front() != first) return 1;\n  auto next = destination.begin();\n  ++next;\n  return &*next != second || *first != 4 || *second != 7;\n}\n",
      "public_header": "forward_list",
      "source_sha256": "6bee322d2b75e456b1b83a81668f493d26594b707307e240593c040cc58376dd",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-moved-from-owner-can-be-reused",
      "expected": "accept",
      "source": "#include <forward_list>\n#include <utility>\nint main() {\n  std::forward_list<int> original{3, 5};\n  std::forward_list<int> moved(std::move(original));\n  original.push_front(9);\n  moved.pop_front();\n  return original.front() != 9 || moved.front() != 5;\n}\n",
      "public_header": "forward_list",
      "source_sha256": "c72eda111ff6214b6829473d253b16c5b796992e3b54cb5d0e48b897170bfeb2",
