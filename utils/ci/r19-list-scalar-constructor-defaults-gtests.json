    {
      "name": "list-plain-default-ctor-earlier-scalar-member",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nstruct Entry {\n  int key, derived;\n  Entry() : key(4), derived(key * 3 + 1) {}\n};\nint main() {\n  std::list<Entry> rows(2);\n  auto& first = rows.emplace_front();\n  if (rows.size() != 3 || first.key != 4 || first.derived != 13) return 1;\n  rows.resize(4);\n  return rows.back().derived != 13;\n}\n",
      "source_sha256": "ba366e583993966aeb6b30bccdf5992c1a2faceb221cb38188b1c95c3cf1282f"
    },
    {
      "name": "forward-list-plain-default-ctor-nested-field-defaults",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nstruct Leaf {\n  int key = 7;\n  int mirror = key + 3;\n  Leaf() {}\n};\nstruct Entry { Leaf values[2]; };\nint main() {\n  std::forward_list<Entry> rows;\n  auto& current = rows.emplace_front();\n  if (current.values[0].key != 7 || current.values[1].mirror != 10) return 1;\n  rows.resize(2);\n  auto after = rows.begin();\n  ++after;\n  return after->values[1].mirror != 10;\n}\n",
      "source_sha256": "1c7a6d77fc624de67e01560b7396b3ed261a231f5bdacc617cb38c5d9a717882"
    },
    {
      "name": "forward-list-plain-default-ctor-out-of-line-fill",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nstruct Entry {\n  int value;\n  Entry();\n};\nEntry::Entry() : value(7) {}\nint main() {\n  Entry seed;\n  seed.value = 9;\n  std::forward_list<Entry> rows(2, seed);\n  if (rows.front().value != 9) return 1;\n  rows.emplace_front();\n  return rows.front().value != 7;\n}\n",
      "source_sha256": "402509e65947a4024d0f30399c5f5ad0f5b1576fc91628b67f3ed36b8a117610"
    },
    {
      "name": "list-plain-default-ctor-body-guard",
      "section": "list",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source": "#include <list>\nstruct Entry {\n  int value;\n  Entry() : value(7) { ++value; }\n};\nint main() {\n  std::list<Entry> rows(1);\n  return rows.front().value != 8;\n}\n",
      "source_sha256": "8439095f93eaef42592d95104098789110b6dc72eaaff903fc2bd0d92bb4aea9"
    },
