      "expected": "accept",
      "public_header": "set",
      "source": "#include <set>\nint main() {\n  const std::multiset<int> values{1, 3, 3, 7};\n  auto it = values.crbegin();\n  auto end = values.crend();\n  int sum = 0;\n  while (it != end) {\n    sum = sum * 10 + *it;\n    ++it;\n  }\n  const std::multiset<int> empty;\n  return sum == 7331 && empty.rbegin() == empty.rend() ? 0 : 1;\n}\n",
      "source_sha256": "e791e51057ea25ecd80c283d9326ae8486a363252c7dd6520e7a13c27207ec7e",
      "kind": "cpp17-operation"
    },
