      "public_header": "map",
      "source": "#include <map>\nint main() {\n  std::map<int, int> values{{2, 20}, {5, 50}, {7, 70}};\n  auto top = values.rbegin();\n  auto second = top;\n  ++second;\n  second->second = 51;\n  if (top->first != 7 || (*second).first != 5)\n    return 1;\n  auto old = second--;\n  return old->second == 51 && second == top && values.find(5)->second == 51 ? 0 : 2;\n}\n",
      "source_sha256": "c68927b3962db93d67f80e95053b221008c551c4255ca43938d25505476806f5",
      "kind": "cpp17-operation"
