      "name": "ordered-set-reverse-endpoints-and-postfix-step",
      "expected": "accept",
      "public_header": "set",
      "source": "#include <set>\nint main() {\n  std::set<int> values{1, 3, 7};\n  auto it = values.rbegin();\n  auto end = values.rend();\n  if (it.base() != values.end() || end.base() != values.begin() || *it != 7)\n    return 1;\n  auto top = it++;\n  if (*top != 7 || *it != 3 || top == it)\n    return 2;\n  --it;\n  return it == top && *it == 7 ? 0 : 3;\n}\n",
      "source_sha256": "0a3aca3511d5220165c9c5834ee94eb766e2549f9f263b2400fa17a34eddf7f4",
      "kind": "cpp17-operation"
    },
