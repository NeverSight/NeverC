      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Set = std::unordered_set<int>;\nusing Size = decltype(sizeof(0));\nint trace;\nSet& owner(Set& value) { trace = trace * 10 + 1; return value; }\nSize count() { trace = trace * 10 + 2; return 4; }\nint main() {\n  Set values;\n  owner(values).reserve(count());\n  return trace != 12 || values.bucket_count() != 4;\n}\n",
      "source_sha256": "72414d560a3efcf6dbc19bd46445594e55c982ce79814916e4964f8f874bb2e0",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-bucket-storage-bucket-allocation-and-release",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "using Size = decltype(sizeof(0));\nextern \"C\" void* malloc(Size);\nextern \"C\" void free(void*);\n#include <unordered_set>\nint armed, allocations, releases;\nSize first_bytes, second_bytes;\nvoid* operator new(Size bytes) {\n  if (armed) {\n    ++allocations;\n    if (allocations == 1) first_bytes = bytes;\n    else second_bytes = bytes;\n  }\n  return malloc(bytes);\n}\nvoid operator delete(void* pointer) noexcept {\n  if (armed && pointer) ++releases;\n  free(pointer);\n}\nvoid operator delete(void* pointer, Size) noexcept {\n  if (armed && pointer) ++releases;\n  free(pointer);\n}\nint main() {\n  {\n    std::unordered_multiset<int> values;\n    armed = 1;\n    values.rehash(4);\n    values.rehash(7);\n    values.rehash(7);\n    if (allocations != 2 || releases != 1 ||\n        first_bytes != 4 * sizeof(void*) || second_bytes != 7 * sizeof(void*)) return 1;\n  }\n  armed = 0;\n  return releases != 2;\n}\n",
      "source_sha256": "a86d29c8a7bc9f9f93da77bfe30e3d55315351b24a2558ecc28293262df81ecc",
      "kind": "cpp17-operation"
    },
