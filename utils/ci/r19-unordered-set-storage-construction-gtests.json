      "name": "unordered-set-storage-construction-set-bucket-count-default-policies-evaluate-count-once",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <cstddef>\n#include <unordered_set>\nstd::size_t buckets(int& calls) { ++calls; return 17; }\nint main() {\n  int calls = 0;\n  std::unordered_set<int> values(buckets(calls));\n  return calls != 1 || !values.empty() || values.bucket_count() < 17 || values.max_load_factor() != 1.0f;\n}\n",
      "source_sha256": "71a92d22d9c48b1a21c75de0a203df173c28f32e7b3976e4b9f191880de9e452",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-storage-construction-multiset-explicit-hash-equal-and-allocator-bucket-construction",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  const std::hash<int> hash;\n  const std::equal_to<int> equal;\n  const std::allocator<int> allocator;\n  std::unordered_multiset<int> values(13u, hash, equal, allocator);\n  values.insert(2);\n  values.insert(2);\n  return values.size() != 2 || values.count(2) != 2 || values.bucket_count() < 13;\n}\n",
      "source_sha256": "bf0f0fd8437702d34aef000ecd4d0e40a405b3b51a98761ea50fa9d2c831a411",
      "kind": "cpp17-operation"
    },
    {
