      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Alloc = std::allocator<int>;\nconst Alloc& observe(const Alloc& allocator, int& calls) { ++calls; return allocator; }\nint main() {\n  const Alloc allocator;\n  int calls = 0;\n  std::unordered_set<int> values(11u, observe(allocator, calls));\n  return calls != 1 || !values.empty() || values.bucket_count() < 11;\n}\n",
      "source_sha256": "c57fcd81e441cd5b80b5c570fd6d63664fa9dba281d6c900a34fa2026a7cce37",
      "kind": "cpp17-operation"
    },
    {
