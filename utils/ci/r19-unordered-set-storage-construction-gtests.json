      "source": "#include <unordered_set>\nint main() {\n  const std::allocator<int> allocator;\n  std::unordered_multiset<int> values(allocator);\n  if (!values.empty()) return 1;\n  values.insert(7);\n  return values.count(7) != 1;\n}\n",
      "source_sha256": "40da218d6d9c393afcb1245927b6037754562acb5d7ad9862a25b1d78a3dd037",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-storage-construction-set-copy-with-default-allocator-owns-a-distinct-node",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  const std::allocator<int> allocator;\n  const std::unordered_set<int> source{17, 23};\n  std::unordered_set<int> copy(source, allocator);\n  return copy.size() != 2 || &*copy.find(17) == &*source.find(17) || copy.count(23) != 1;\n}\n",
      "source_sha256": "8c681f4d441c87c2252d5417772111fd0ccfeae2f8935638d013ff82f6942117",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-storage-construction-multiset-move-with-equal-default-allocator-retains-node-address",
