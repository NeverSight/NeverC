      "expected": "accept",
      "public_header": "any",
      "source": "#include <any>\n#include <utility>\nint main() {\n  std::any value;\n  auto& n = value.emplace<long>();\n  n = -19L;\n  std::any receiver;\n  receiver = std::move(value);\n  const auto* moved = std::any_cast<long>(&receiver);\n  return value.has_value() || !moved || *moved != -19L;\n}\n",
      "source_sha256": "24cb95c170431e773c061f25308ef6f4c725b0d694c37da42288304911c2cf3d",
      "kind": "cpp17-operation"
    },
