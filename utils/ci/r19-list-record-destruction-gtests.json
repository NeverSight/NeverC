  "source_cases": [
    {
      "name": "list-record-destructor-after-splice-and-erase",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nint trace;\nstruct Entry {\n  int value;\n  ~Entry() { trace = trace * 10 + value; }\n};\nint main() {\n  {\n    std::list<Entry> from;\n    std::list<Entry> to;\n    from.emplace_back().value = 2;\n    from.emplace_back().value = 3;\n    auto saved = from.begin();\n    to.splice(to.begin(), from, saved);\n    if (trace || saved != to.begin()) return 1;\n    to.erase(saved);\n    if (trace != 2 || !to.empty()) return 2;\n  }\n  return trace != 23;\n}\n",
      "source_sha256": "ee0d3aef4d418a4676dc728ea46d8ba84c3edf620f67d53e780776adb68e1add"
    },
    {
      "name": "forward-list-record-nested-destruction-order",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nint trace;\nstruct Leaf {\n  int value;\n  ~Leaf() { trace = trace * 10 + value; }\n};\nstruct Row { Leaf first; Leaf second; };\nint main() {\n  std::forward_list<Row> rows;\n  auto& later = rows.emplace_front();\n  later.first.value = 3;\n  later.second.value = 4;\n  auto& earlier = rows.emplace_front();\n  earlier.first.value = 1;\n  earlier.second.value = 2;\n  rows.pop_front();\n  if (trace != 21) return 1;\n  rows.clear();\n  return trace != 2143 || !rows.empty();\n}\n",
      "source_sha256": "e6b651bd856316261e27a0227323edbe89dabd7ef2d8c8b7123512fd309f695f"
    },
    {
      "name": "list-record-potentially-throwing-destructor-guard",
      "section": "list",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source": "#include <list>\nstruct Entry {\n  int value;\n  ~Entry() noexcept(false) { value = 0; }\n};\nint main() {\n  std::list<Entry> rows;\n  rows.emplace_back().value = 9;\n  return rows.back().value != 9;\n}\n",
      "source_sha256": "7d37949263db01638fa31a982816dc2964a8fdd16f88f292eb9131a31fa8aed1"
    },
    {
      "name": "forward-list-record-destructor-with-custom-copy-guard",
      "section": "forward_list",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source": "#include <forward_list>\nint copied;\nstruct Entry {\n  int value;\n  Entry() = default;\n  Entry(const Entry& other) : value(other.value) { ++copied; }\n  ~Entry() { value = 0; }\n};\nint main() {\n  std::forward_list<Entry> rows;\n  rows.emplace_front().value = 2;\n  auto copy = rows;\n  return copy.front().value != 2 || copied != 1;\n}\n",
      "source_sha256": "aa8de6a6c0bb1e17fef8fc137c3079e52440930411dee076f75fd4396c26f21f"
    }
  ],
