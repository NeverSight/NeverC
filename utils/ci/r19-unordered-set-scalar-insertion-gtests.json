  "source_cases": [
    {
      "name": "unordered-set-scalar-insertion-set-returns-position-and-insertion-flag",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> values;\n  values.reserve(8);\n  auto first = values.insert(11);\n  if (!first.second || first.first == values.end() || *first.first != 11) return 1;\n  const int key = 11;\n  auto second = values.insert(key);\n  return second.second || second.first != first.first || second.first != values.find(key) || values.size() != 1;\n}\n",
      "source_sha256": "8b10c5f7ae601e758e1f82e7b61bcf45beb43740b48d9eaa0254c84ec39cdeeb",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-scalar-insertion-set-insertion-evaluates-receiver-and-argument-once",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Set = std::unordered_set<int>;\nint trace;\nSet& receiver(Set& values) { trace = trace * 10 + 1; return values; }\nint argument() { trace = trace * 10 + 2; return -7; }\nint main() {\n  Set values;\n  if (!receiver(values).insert(argument()).second || trace != 12) return 1;\n  return values.count(-7) != 1 || values.insert(-7).second;\n}\n",
      "source_sha256": "f8310f6d6c52df95fa12cfd1f96dbdff2cc18b424c0311028c10441a944dfb48",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-scalar-insertion-multiset-returns-the-new-node",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> values;\n  values.reserve(8);\n  const int key = -4;\n  auto first = values.insert(key);\n  auto second = values.insert(-4);\n  return first == second || first == values.end() || second == values.end() ||\n      *first != -4 || *second != -4 || values.count(-4) != 2;\n}\n",
      "source_sha256": "4ee0102db9839653a7029d356c9ef8daa35df6f85840e80f22c1869c4a9d4e61",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-scalar-insertion-mixed-scalar-and-list-insert",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> values{3, 7, 3};\n  values.insert({3, 7});\n  auto added = values.insert(3);\n  if (*added != 3 || values.count(3) != 4 || values.count(7) != 2) return 1;\n  return values.erase(3) != 4 || values.count(7) != 2;\n}\n",
      "source_sha256": "3de76d16e0e5a09795525a1e4fa84822b5186d85c9e5d6c6f2df1189b27a35ff",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-scalar-insertion-insert-with-hint",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() { std::unordered_set<int> values; return *values.insert(values.cend(), 2) != 2; }\n",
      "source_sha256": "9093f70f4ab2740954e61520008f406ca8a0f0ccf6f1dbf41185f3046faf4c69",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-scalar-insertion-custom-hash",
