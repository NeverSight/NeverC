      "name": "variant-visit-instantiates-two-template-arguments",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <variant>\nstruct Difference {\n  template<class L, class R>\n  int operator()(const L& left, const R& right) const {\n    return int(left) - int(right) + int(sizeof(L)) - int(sizeof(R));\n  }\n};\nint main() {\n  using Item = std::variant<int, short>;\n  Item left(18);\n  const Item right(std::in_place_index<1>, short(6));\n  Difference difference{};\n  return std::visit(difference, left, right) != 12 + int(sizeof(int)) - int(sizeof(short));\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "b8b61b27eec5b469e07da8c1050026cf53cfebaf84a0bb9436e5f899e5772dec"
    },
