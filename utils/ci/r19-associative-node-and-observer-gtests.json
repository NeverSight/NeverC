  "source_cases": [
    {
      "name": "unordered-multimap-node-handles-extract-iterator-and-reinsert-mutated-mapped-value",
      "expected": "accept",
      "public_header": "unordered_map",
      "source": "#include <unordered_map>\n#include <utility>\nint main() {\n  std::unordered_multimap<int, int> values{{3, 5}, {3, 9}, {6, 12}};\n  auto where = values.find(3);\n  const int* address = &where->second;\n  auto node = values.extract(where);\n  if (node.empty() || values.count(3) != 1) return 1;\n  node.key() = 6;\n  node.mapped() = 17;\n  const auto inserted = values.insert(std::move(node));\n  return !node.empty() || inserted->first != 6 || inserted->second != 17 ||\n         &inserted->second != address || values.count(6) != 2;\n}\n",
      "source_sha256": "557863fbfa49e6670cd7c19ef444ef26b85fcc3af82271f48445cd20c5fd6773",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-multimap-node-handles-rejected-unique-insertion-returns-handle-for-multimap",
      "expected": "accept",
      "public_header": "unordered_map",
      "source": "#include <unordered_map>\n#include <utility>\nint main() {\n  std::unordered_multimap<int, int> source{{3, 17}, {3, 22}};\n  std::unordered_map<int, int> unique{{3, 5}};\n  auto node = source.extract(3);\n  const auto payload = node.mapped();\n  auto rejected = unique.insert(std::move(node));\n  if (rejected.inserted || rejected.position->second != 5 ||\n      rejected.node.empty() || rejected.node.key() != 3 || rejected.node.mapped() != payload) return 1;\n  auto inserted = source.insert(source.find(3), std::move(rejected.node));\n  return !rejected.node.empty() || inserted->second != payload || source.count(3) != 2;\n}\n",
      "source_sha256": "29ae011b92e445a0b06ebd197d074a0f9ebc44164b8aa022d163d54dd433a538",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-multimap-node-handles-empty-extraction-and-insertion-return-end",
      "expected": "accept",
      "public_header": "unordered_map",
      "source": "#include <unordered_map>\n#include <utility>\nint main() {\n  std::unordered_multimap<int, int> values{{3, 11}};\n  auto absent = values.extract(9);\n  const auto inserted = values.insert(std::move(absent));\n  return bool(absent) || inserted != values.end() || values.count(3) != 1;\n}\n",
      "source_sha256": "58b5bfa774e70a1847915e658d461f7d6a96da3678fb6411c5b2648fbf37c9b3",
      "kind": "cpp17-operation"
    },
    {
      "name": "ordered-pointer-observers-map-size-empty-and-maximum",
      "expected": "accept",
      "public_header": "map",
      "source": "#include <map>\nusing Table = std::map<int, int>;\nconst Table* observe(const Table& values, unsigned& calls) { ++calls; return &values; }\nint main() {\n  const Table values;\n  unsigned calls = 0;\n  const auto maximum = observe(values, calls)->max_size();\n  const auto* pointer = &values;\n  return calls != 1 || maximum != values.max_size() || !pointer->empty() || pointer->size() != 0;\n}\n",
      "source_sha256": "a4b2645ad035fb23c4d4eed72aa40baa930232972c4aae5d204c2d14ac6bbf7d",
      "kind": "cpp17-operation"
    },
    {
      "name": "ordered-pointer-observers-multimap-pointer-key-comparator-evaluates-receiver",
      "expected": "accept",
      "public_header": "map",
      "source": "#include <map>\nusing Table = std::multimap<int, int>;\nconst Table* observe(const Table& values, unsigned& calls) { ++calls; return &values; }\nint main() {\n  const Table values;\n  unsigned calls = 0;\n  auto compare = observe(values, calls)->key_comp();\n  return calls != 1 || !compare(-2, 7) || compare(7, -2);\n}\n",
      "source_sha256": "84bbb1c5a6676778101ffdbc81c2c8c154545b7519e0dd6605c28c197f4d89bf",
      "kind": "cpp17-operation"
    },
    {
      "name": "ordered-pointer-observers-multiset-pointer-value-comparator",
      "expected": "accept",
      "public_header": "set",
      "source": "#include <set>\nint main() {\n  const std::multiset<int> values;\n  const auto* pointer = &values;\n  return !pointer->value_comp()(3, 7) || pointer->key_comp()(3, 3) || !pointer->empty();\n}\n",
      "source_sha256": "cfc31788abf4ff877558cbd80101370a3aef4bf96382774aeea65f87021a54fc",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-multimap-node-handles-mapped-node-with-unapproved-value-type",
      "expected": "accept",
      "public_header": "unordered_map",
      "source": "#include <unordered_map>\nint main() {\n  std::unordered_multimap<int, long> values{{3, 11L}};\n  auto node = values.extract(3);\n  return node.mapped() != 11L;\n}\n",
      "source_sha256": "f920b619c93b14e14234adf89b5718c506cf3a4a3e3838d23ba17d4b7d51536c",
      "kind": "cpp17-operation"
    },
    {
      "name": "ordered-pointer-observers-custom-ordered-compare-pointer",
      "expected": "reject",
      "public_header": "map",
      "source": "#include <map>\nstruct Greater { bool operator()(int a, int b) const { return a > b; } };\nint main() {\n  const std::map<int, int, Greater> values;\n  return (&values)->key_comp()(1, 2);\n}\n",
      "source_sha256": "6ceac9d5b311aef857be7965f33e5be3811368446da4ee6411723d27f9c6a100",
      "kind": "source-body-guard"
    }
