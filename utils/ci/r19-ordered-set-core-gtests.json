  "source_cases": [
    {
      "name": "ordered-set-list-and-lookup-list-balances-sorted-keys-and-deduplicates",
      "expected": "accept",
      "public_header": "set",
      "source": "#include <set>\nint main() {\n  const std::set<int> numbers{-13, -7, -4, -1, 0, 2, 3, 5, 7, 9, 10, 12, 7, 3};\n  if (numbers.size() != 12 || numbers.empty()) return 1;\n  for (int key = -13; key < 13; ++key) {\n    const bool expected = key == -13 || key == -7 || key == -4 || key == -1 ||\n                          key == 0 || key == 2 || key == 3 || key == 5 ||\n                          key == 7 || key == 9 || key == 10 || key == 12;\n    if (numbers.count(key) != unsigned(expected)) return 2;\n  }\n}\n",
      "source_sha256": "5fd4e5a7a6817bf46064524fa29b4438030a6e53033fa6008ca454965e5e5156",
      "kind": "cpp17-operation"
    },
    {
      "name": "ordered-set-list-and-lookup-pointer-count-after-left-and-right-rotations",
      "expected": "accept",
      "public_header": "set",
      "source": "#include <set>\n#include <functional>\nint main() {\n  const std::set<int> values({8, 14, 13, 4, 5, 3, 20, 19}, std::less<int>{});\n  const auto* receiver = &values;\n  return receiver->count(5) != 1 || receiver->count(20) != 1 ||\n         receiver->count(8) != 1 || receiver->count(7) != 0 || receiver->size() != 8;\n}\n",
      "source_sha256": "eb6f103dacc2fb764f42256a72f3a242cff39e0eec13bf3fea634a9b485116a8",
      "kind": "cpp17-operation"
    },
    {
      "name": "ordered-set-list-and-lookup-list-duplicates-release-each-owned-node-once",
      "expected": "accept",
      "public_header": "set",
      "source": "#include <cstddef>\n#include <cstdlib>\n#include <set>\nunsigned allocating, releasing;\nvoid* operator new(std::size_t bytes) { ++allocating; return std::malloc(bytes); }\nvoid operator delete(void* p) noexcept { ++releasing; std::free(p); }\nvoid operator delete(void* p, std::size_t) noexcept { ++releasing; std::free(p); }\nint main() {\n  {\n    const std::set<int> values{3, 1, 7, 3, 9, 7};\n    if (values.size() != 4 || allocating != 4 || releasing != 0) return 1;\n  }\n  return allocating != 4 || releasing != 4;\n}\n",
      "source_sha256": "19b9591724cc4705409a2c8edf2c5a41e66e9288e85fdf92e1e5b28f2e681cd9",
      "kind": "cpp17-operation"
    },
    {
      "name": "ordered-set-insert-result-insertion-result-distinguishes-a-duplicate-key",
      "expected": "accept",
      "public_header": "set",
      "source": "#include <set>\nint main() {\n  std::set<int> values;\n  int key = -9;\n  auto added = values.insert(key);\n  auto duplicate = values.insert(key);\n  auto other = values.insert(3);\n  return !added.second || duplicate.second || !other.second || values.size() != 2 ||\n         values.count(-9) != 1 || values.count(0) != 0;\n}\n",
      "source_sha256": "dacd85447b1580ef82cf1f3d9ae4b18bb2c6ff891f7262d4c6335a659a7ebac1",
      "kind": "cpp17-operation"
    },
    {
      "name": "ordered-set-insert-result-pointer-insertion-uses-the-checked-receiver-once",
      "expected": "accept",
      "public_header": "set",
      "source": "#include <set>\nusing Set = std::set<int>;\nSet* receiver(Set& values, int& calls) { ++calls; return &values; }\nint main() {\n  Set values{9, 7, 3};\n  int calls = 0;\n  auto result = receiver(values, calls)->insert(-6);\n  return calls != 1 || !result.second || values.count(-6) != 1 || values.size() != 4;\n}\n",
      "source_sha256": "566aa51301b9b4509ef506c76637dd8696f4e00c087d89dc2a5705ff84a03f80",
      "kind": "cpp17-operation"
    },
    {
      "name": "ordered-set-iterator-ordered-range-and-insertion-preserve-existing-position",
      "expected": "accept",
      "public_header": "set",
      "source": "#include <set>\nint main() {\n  std::set<int> values{9, -6, 3, 7, 3};\n  auto state = values.insert(-2);\n  if (!state.second || *state.first != -2) return 1;\n  int previous = -8, count = 0;\n  for (const int value : values) {\n    if (value <= previous) return 2;\n    previous = value;\n    ++count;\n  }\n  return previous != 9 || count != 5;\n}\n",
      "source_sha256": "0735662eed0b6c8a84e129f7b5aad745c92bc4766e0ab7919b3eed7a415ac465",
      "kind": "cpp17-operation"
    },
    {
      "name": "ordered-set-iterator-pointer-endpoints-and-postfix-traversal",
      "expected": "accept",
      "public_header": "set",
      "source": "#include <set>\nint main() {\n  const std::set<int> values{9, -6, 3, 7};\n  const auto* receiver = &values;\n  auto last = receiver->cend();\n  --last;\n  auto previous = last--;\n  auto first = receiver->cbegin();\n  auto old = first++;\n  return *last != 7 || *previous != 9 || *first != 3 || *old != -6;\n}\n",
      "source_sha256": "35a1d1206dfa4f9d3090e1329efdb8474c7a80c14fbe837ade7bfe14779ade18",
      "kind": "cpp17-operation"
    },
    {
