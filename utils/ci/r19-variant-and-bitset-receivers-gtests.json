    {
      "name": "bitset-unsigned-conversion-through-const-copy-and-alias",
      "public_header": "bitset",
      "expected": "accept",
      "source": "#include <bitset>\nint main() {\n  using Bits = std::bitset<129>;\n  const Bits initial(5);\n  const Bits copied(initial);\n  const Bits& alias = copied;\n  return alias.to_ullong() != 5ULL;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "d5164115bd72fbb0fccfd3a80eed2f08748d8230befc941c45badf118a9d5016"
    },
    {
      "name": "bitset-unsigned-conversion-selects-one-immutable-receiver",
      "public_header": "bitset",
      "expected": "accept",
      "source": "#include <bitset>\nstatic bool select(int& calls) { ++calls; return calls == 1; }\nint main() {\n  using Bits = std::bitset<129>;\n  const Bits first(0x80000000ULL), second(7ULL);\n  int calls = 0;\n  unsigned long a = (select(calls) ? first : second).to_ulong();\n  unsigned long b = (select(calls) ? first : second).to_ulong();\n  return calls != 2 || a != 0x80000000UL || b != 7UL;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "b6b85f9f21cd69b52d91c4cb4ba5a9a52fd02f7bc192d7a9498380e3bbf5c10a"
    },
    {
      "name": "variant-visit-nonowning-static-cast-preserves-owner",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <variant>\nusing Value = std::variant<int, short>;\nint read(int value) { return value; }\nint main() {\n  Value item(std::in_place_index<1>, short{7});\n  int before = std::visit(read, static_cast<Value&&>(item));\n  item.emplace<0>(11);\n  return before != 7 || std::visit(read, item) != 11;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "daa469caa5f753e0e16a807c26dd0201a28006bb7e2abb49fe2384335b9b9b85"
    },
    {
      "name": "variant-visit-nonowning-move-const-operand",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <utility>\n#include <variant>\nusing Value = std::variant<int, short>;\nint read(int value) { return value; }\nint main() {\n  const Value item(std::in_place_index<0>, 13);\n  return std::visit(read, std::move(item)) != 13;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "68e854919b6ebc9698dd95aca17dc8810397da69f0d596ea421952c7f64cf52d"
    },
    {
      "name": "variant-visit-mixed-bound-and-xvalue-operands",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <utility>\n#include <variant>\nusing Value = std::variant<int, short>;\nint subtract(int left, int right) { return left - right; }\nint main() {\n  Value left(std::in_place_index<1>, short{17});\n  Value right(std::in_place_index<0>, 5);\n  return std::visit(subtract, left, std::move(right)) != 12;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "61c5d345eb4be08db62c8bf136c676a0d7296c077e41c7a2ece08af04146e41c"
    },
    {
      "name": "variant-visit-unverified-xvalue-returning-call",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <variant>\nusing Value = std::variant<int>;\nValue&& produce(Value& value) { return static_cast<Value&&>(value); }\nint read(int value) { return value; }\nint test(Value& item) { return std::visit(read, produce(item)); }\n",
      "kind": "cpp17-operation",
      "source_sha256": "efbf45a652be61dd3507647e8735ed57806040721b14a3349ab46de86c0a9b86"
    }
