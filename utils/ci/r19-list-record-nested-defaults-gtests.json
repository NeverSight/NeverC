  "source_cases": [
    {
      "name": "list-nested-record-default-and-destroy-order",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nint sequence, released;\nint next() { return ++sequence; }\nstruct Leaf {\n  int value = next();\n  int mirrored = value + 10;\n  ~Leaf() noexcept { released = released * 10 + value; }\n};\nstruct Entry { int prefix = next(); Leaf leaf; int suffix = next(); };\nint main() {\n  std::list<Entry> rows(1);\n  if (sequence != 3 || rows.front().prefix != 1 || rows.front().leaf.mirrored != 12 ||\n      rows.front().suffix != 3) return 1;\n  rows.resize(2);\n  if (sequence != 6 || rows.back().prefix != 4 || rows.back().leaf.mirrored != 15 ||\n      rows.back().suffix != 6) return 1;\n  rows.pop_back();\n  if (released != 5) return 1;\n  rows.clear();\n  return released != 52;\n}\n",
      "source_sha256": "df2b15638291ccefd7bb9773812251e267467a54bb022726cdf1a245f3fa93ef"
    },
    {
      "name": "forward-list-nested-array-default-and-destroy-order",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nint sequence, released;\nint next() { return ++sequence; }\nstruct Leaf {\n  int ticket = next();\n  ~Leaf() noexcept { released = released * 10 + ticket; }\n};\nstruct Entry { Leaf fields[2]; int marker = next(); };\nint main() {\n  std::forward_list<Entry> rows;\n  auto& item = rows.emplace_front();\n  if (sequence != 3 || item.fields[0].ticket != 1 || item.fields[1].ticket != 2 ||\n      item.marker != 3 || released) return 1;\n  rows.clear();\n  return released != 21;\n}\n",
      "source_sha256": "be967c65b82570c75a30f77d2f5a2794ceda12dda01f22b2cfdc9263089cd4f4"
    },
    {
      "name": "list-deep-record-only-nested-defaults",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nint sequence;\nint next() { return ++sequence; }\nstruct Leaf { int key = next(); int mirror = key + 3; };\nstruct Middle { Leaf leaf; };\nstruct Entry { Middle inner; };\nint main() {\n  std::list<Entry> rows(1);\n  if (sequence != 1 || rows.front().inner.leaf.mirror != 4) return 1;\n  rows.emplace_back();\n  return sequence != 2 || rows.back().inner.leaf.mirror != 5;\n}\n",
      "source_sha256": "0c1dedb365eb8cda92b6e3d1f0eb4e46589e69fa61cce6672866c243b83928f5"
    },
    {
      "name": "list-nested-user-provided-default-constructor-guard",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nstruct Leaf { int value; Leaf() : value(7) {} };\nstruct Entry { Leaf field; };\nint main() {\n  std::list<Entry> rows(1);\n  return rows.front().field.value != 7;\n}\n",
      "source_sha256": "e5d5230afd70ad53f357047ecd9565f7334c9d41825fe08651b60bc37909242c"
    },
    {
      "name": "forward-list-nested-indirect-default-call-guard",
      "section": "forward_list",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source": "#include <forward_list>\nint next() { return 7; }\nint (*getValue)() = next;\nstruct Leaf { int value = getValue(); };\nstruct Entry { Leaf field; };\nint main() {\n  std::forward_list<Entry> rows(1);\n  return rows.front().field.value != 7;\n}\n",
      "source_sha256": "2c67394c53c2c7a792c63879c8b8f4a43d1769afdddb3f938f0de727b485daa5"
    }
