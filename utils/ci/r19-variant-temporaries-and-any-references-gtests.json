  "source_cases": [
    {
      "name": "variant-visit-temporary-evaluates-its-initializer-once",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <variant>\nusing Value = std::variant<short, int>;\nint combine(int first, int second, int third) {\n  return first * 100 + second * 10 + third;\n}\nint payload(int& calls) {\n  ++calls;\n  return 5;\n}\nint main() {\n  Value a{std::in_place_index<0>, static_cast<short>(2)}, b{3};\n  int calls = 0;\n  const auto result = std::visit(combine, a, b, Value{payload(calls)});\n  return result != 235 || calls != 1;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "28da5ec21744eb4f67a7d54397ea10ff72d0ddd82053257f17404808b7977b84"
    },
    {
      "name": "variant-visit-temporary-selects-owned-visitor-call",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <variant>\nstruct Visitor {\n  int bias;\n  int operator()(int value) const { return value + bias; }\n};\nint main() {\n  const Visitor visitor{17};\n  using Value = std::variant<short, int>;\n  return std::visit(visitor, Value{std::in_place_index<0>, static_cast<short>(4)}) != 21;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "08e74928db2cb57b3a58d65668dabc0fd7f75fecb00f95293267e877e0f35c79"
    },
    {
      "name": "variant-visit-temporary-with-mutable-live-operand",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <variant>\nvoid remember(int& output, int value) { output = value; }\nint main() {\n  std::variant<int> output{1};\n  using Input = std::variant<short, int>;\n  std::visit(remember, output, Input{6});\n  auto* result = std::get_if<0>(&output);\n  return !result || *result != 6;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "53da0121ba8020f1a3245cce43cb6b28c9b42427eca74b74d19f23a4d2785537"
    },
