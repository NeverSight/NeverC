    {
      "name": "variant-monostate-comparison-same-index-has-no-payload-order",
      "expected": "accept",
      "public_header": "variant",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing Value = std::variant<std::monostate, int>;\nint main() {\n  const Value a, b;\n  if (!(a == b) || a != b || a < b || a > b || !(a <= b) || !(a >= b))\n    return 1;\n  const Value c(std::in_place_index<1>, -9), d(std::in_place_index<1>, 3);\n  if (!(a < c) || !(c > a) || a == c || !(a != c)) return 2;\n  return !(c < d) || !(d >= c) || c == d;\n}\n",
      "source_sha256": "9947f1411dbe4a65a6c5bd3ec86a7373392b86e655c14a9ac0eeb10de92d5ce8"
    },
    {
      "name": "variant-monostate-comparison-distinct-empty-alternative-indexes",
      "expected": "accept",
      "public_header": "variant",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing Value = std::variant<std::monostate, int, std::monostate>;\nint left_reads, right_reads;\nconst Value& left(const Value& v) { ++left_reads; return v; }\nconst Value& right(const Value& v) { ++right_reads; return v; }\nint main() {\n  const Value a, b(std::in_place_index<2>);\n  if (!std::operator<(left(a), right(b))) return 1;\n  if (std::operator==(left(a), right(b))) return 2;\n  if (!std::operator>=(left(b), right(b))) return 3;\n  return left_reads != 3 || right_reads != 3;\n}\n",
      "source_sha256": "06c1961142225e285c1aa907292bd35e3ec87f5d59389a2949afe4bb9216ebf9"
    },
    {
      "name": "variant-monostate-comparison-replacement-empty-class",
      "expected": "reject",
      "public_header": "variant",
      "kind": "source-body-guard",
      "source": "#include <variant>\nstruct Empty {};\nconstexpr bool operator<(Empty, Empty) noexcept { return true; }\nusing Value = std::variant<Empty, int>;\nbool compare(const Value& a, const Value& b) { return a < b; }\n",
      "source_sha256": "2a42cdc91347511bfbee4573c9df8be307acd4f01fddd6b14eaad5d06203c8c9"
    },
    {
      "name": "variant-monostate-comparison-renamed-sdk-monostate",
      "expected": "reject",
      "public_header": "variant",
      "kind": "source-body-guard",
      "source": "#define monostate alternate_monostate\n#include <variant>\n#undef monostate\nusing Value = std::variant<std::alternate_monostate, int>;\nbool compare(const Value& a, const Value& b) { return a == b; }\n",
      "source_sha256": "ae88a1178a1451bd9aa7952d08222061aee097e4bd64cc05d67d2a8d97a62269"
    }
