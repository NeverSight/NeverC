      "source": "#include <forward_list>\nstruct Entry {\n  int key;\n  int tag;\n  bool operator<(const Entry& rhs) const {\n    return key < rhs.key || (key == rhs.key && tag < rhs.tag);\n  }\n};\nint main() {\n  std::forward_list<Entry> values{{1, 2}, {1, 1}};\n  values.sort();\n  return values.front().tag != 1;\n}\n",
      "source_sha256": "298026cf52b6a4ea86f2bd619a0143e83212c7b8a79c0742db993258591e36ed"
    },
