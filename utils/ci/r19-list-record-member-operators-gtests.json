  "source_cases": [
    {
      "name": "list-record-member-owner-order",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nstruct Entry {\n  int key;\n  int tag;\n  bool operator<(const Entry& other) const & { return key < other.key; }\n};\nint main() {\n  const std::list<Entry> left{{1, 6}, {2, 7}}, right{{1, 8}, {3, 9}}, prefix{{1, 0}};\n  return !(left < right) || !(right > left) || right <= left ||\n         !(prefix < left) || !(left >= prefix);\n}\n",
      "source_sha256": "6c2d0758cb9883175ec995c9538f10a1d2fd321a41e10271fc63543135cebb81"
    },
    {
      "name": "forward-list-record-member-owner-equality",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nstruct Entry {\n  unsigned key;\n  int tag;\n  bool operator==(const Entry& other) const { return other.key == this->key; }\n};\nint main() {\n  const std::forward_list<Entry> left{{1, 6}, {2, 7}}, same{{1, 8}, {2, 9}};\n  const std::forward_list<Entry> prefix{{1, 0}}, different{{1, 0}, {3, 0}};\n  return !(left == same) || left != same || left == prefix || !(left != different);\n}\n",
      "source_sha256": "fe8408bb93d0929de1dbbe4be37052e2ff86780fdafea181a1b3521aad73a452"
    },
    {
      "name": "forward-list-record-member-owner-order",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nstruct Entry {\n  short key;\n  int tag;\n  bool operator<(const Entry& other) const { return this->key > other.key; }\n};\nint main() {\n  const std::forward_list<Entry> left{{8, 6}, {4, 7}}, right{{8, 8}, {2, 9}}, prefix{{8, 0}};\n  return !(left < right) || !(right > left) || right <= left ||\n         !(prefix < left) || !(left >= prefix);\n}\n",
      "source_sha256": "9c6583cf3b7b2db4bc8a2e8d49bcdac8735b85766c4b4eacde5828484be71cc1"
    },
    {
      "name": "list-record-member-remove-and-unique",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nstruct Entry {\n  int key;\n  int tag;\n  bool operator==(const Entry& rhs) const { return key == rhs.key; }\n};\nint main() {\n  std::list<Entry> values{{1, 7}, {2, 5}, {2, 6}, {1, 9}, {3, 8}};\n  const auto& removed = values.front();\n  auto kept = values.begin();\n  ++kept;\n  values.remove(removed);\n  values.unique();\n  return values.size() != 2 || values.begin() != kept || kept->tag != 5 || values.back().tag != 8;\n}\n",
      "source_sha256": "4eb629d4ccbc3445894e1d72639c0a2adf437b66ace7a319cafcf502435b5c66"
    },
    {
      "name": "forward-list-record-member-stable-sort-and-merge",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nstruct Entry {\n  unsigned key;\n  int tag;\n  bool operator<(const Entry& rhs) const { return key < rhs.key; }\n};\nint main() {\n  std::forward_list<Entry> left{{3, 7}, {1, 5}, {3, 6}}, right{{1, 8}, {3, 9}};\n  auto original = left.begin();\n  left.sort();\n  left.merge(right);\n  auto it = left.begin();\n  if (!right.empty() || it->tag != 5 || (++it)->tag != 8) return 1;\n  return ++it != original || (++it)->tag != 6 || (++it)->tag != 9 || ++it != left.end();\n}\n",
      "source_sha256": "edd77bff91ca64af4d50899da5bb5c154416ec3b672b2410e8ef2bb062a1ddef"
    },
    {
      "name": "forward-list-record-member-remove-and-unique",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nstruct Entry {\n  short key;\n  int tag;\n  bool operator==(const Entry& rhs) const { return rhs.key == key; }\n};\nint main() {\n  std::forward_list<Entry> data{{1, 7}, {2, 5}, {2, 6}, {1, 9}, {3, 8}};\n  const auto& removed = data.front();\n  auto kept = data.begin();\n  ++kept;\n  data.remove(removed);\n  data.unique();\n  auto it = data.begin();\n  return it != kept || it->tag != 5 || (++it)->tag != 8 || ++it != data.end();\n}\n",
      "source_sha256": "173c7470324c75114ce96fcc0f9ef49b4bdb42a5bfcebfbf894677afc187c479"
    },
    {
      "name": "list-record-compound-member-owner-order-guard",
