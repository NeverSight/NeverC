  "source_cases": [
    {
      "name": "variant-guarded-get-mutable-reference",
      "expected": "accept",
      "public_header": "variant",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing V = std::variant<int, int>;\nint increment(V& state) {\n  if (state.index() == 1) {\n    int& item = (std::get<1>(state));\n    item += 3;\n    return &item == std::get_if<1>(&state) ? item : -2;\n  }\n  return -1;\n}\nint main() {\n  V active(std::in_place_index<1>, 4);\n  V inactive(std::in_place_index<0>, 2);\n  return increment(active) != 7 || increment(inactive) != -1 ||\n         *std::get_if<1>(&active) != 7 || *std::get_if<0>(&inactive) != 2;\n}\n",
      "source_sha256": "d7c9d5fb24ae68e62cb495b3ed723133e85940121ea732941d960e4231e9e17f"
    },
    {
      "name": "variant-guarded-get-const-reference",
      "expected": "accept",
      "public_header": "variant",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing V = std::variant<int, double>;\nint read(const V& state) {\n  if (std::holds_alternative<double>(state))\n    return std::get<double>(state);\n  return -1;\n}\nint main() {\n  const V active{42.5};\n  const V inactive{7};\n  return read(active) != 42 || read(inactive) != -1;\n}\n",
      "source_sha256": "63c0ce25e7a2f81467420716e379a4bd88fb15fd398e339e06c638a2951bdf56"
    },
    {
      "name": "variant-guarded-get-short-circuit",
      "expected": "accept",
      "public_header": "variant",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing V = std::variant<int, double>;\nbool read(V& state) {\n  return std::holds_alternative<int>(state) && std::get<int>(state);\n}\nint main() {\n  V zero{0};\n  V nonzero{6};\n  V inactive{4.5};\n  return read(zero) || !read(nonzero) || read(inactive);\n}\n",
      "source_sha256": "66343d7f7e6523567ababc577d5a4cf8ee558ddaabaa3c8c85d911ebe8d4ee2a"
    },
    {
      "name": "variant-guarded-get-recheck-after-emplace",
      "expected": "accept",
      "public_header": "variant",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing V = std::variant<std::monostate, long>;\nint main() {\n  V state;\n  if (std::holds_alternative<std::monostate>(state)) {\n    auto& empty = std::get<std::monostate>(state);\n    if (&empty != std::get_if<0>(&state)) return 1;\n  }\n  state.emplace<1>(2L);\n  if (std::holds_alternative<long>(state)) {\n    long& item = std::get<1>(state);\n    item *= 7;\n    return item != 14 || std::get_if<0>(&state) != nullptr;\n  }\n  return 2;\n}\n",
      "source_sha256": "afb2e7a2e32d528fb9ffcb19f33c6a0db82acaa94b8bd6fbacd2f77ce1c58d68"
    },
