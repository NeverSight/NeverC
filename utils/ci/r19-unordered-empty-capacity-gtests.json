  "source_cases": [
    {
      "name": "unordered-empty-capacity-set-max-size",
      "expected": "accept",
      "public_header": "unordered_set",
      "kind": "cpp17-operation",
      "source": "#include <unordered_set>\nint main() {\n  using Set = std::unordered_set<int>;\n  const Set values;\n  Set::size_type maximum = values.max_size();\n  return maximum != Set::size_type(-1) / 24 || !values.empty();\n}\n",
      "source_sha256": "95b30944071ae9127c45d17b45e559f7003d868dfe34ee765202c14bc68fb360"
    },
    {
      "name": "unordered-empty-capacity-multiset-max-buckets",
      "expected": "accept",
      "public_header": "unordered_set",
      "kind": "cpp17-operation",
      "source": "#include <unordered_set>\nint main() {\n  using Set = std::unordered_multiset<int>;\n  Set values;\n  Set::size_type maximum = values.max_bucket_count();\n  return maximum != Set::size_type(-1) / 24 || values.bucket_count() != 0;\n}\n",
      "source_sha256": "51b02740675825172d8abb5d9d36d6769518242d880b44e7459153eab13f031c"
    },
    {
      "name": "unordered-empty-capacity-single-receiver-evaluation",
      "expected": "accept",
      "public_header": "unordered_set",
      "kind": "cpp17-operation",
      "source": "#include <unordered_set>\nusing Set = std::unordered_set<int>;\nconst Set& observe(int& calls, const Set& values) {\n  ++calls;\n  return values;\n}\nint main() {\n  const Set values;\n  int calls = 0;\n  Set::size_type maximum = observe(calls, values).max_bucket_count();\n  return calls != 1 || maximum != values.max_size();\n}\n",
      "source_sha256": "883c8cd270eed5753556804d77209805cc7f6198349d72a37b1079afcdd3c200"
    },
    {
      "name": "unordered-empty-capacity-nested-multiset",
      "expected": "accept",
      "public_header": "unordered_set",
      "kind": "cpp17-operation",
      "source": "#include <unordered_set>\nusing Set = std::unordered_multiset<int>;\nSet::size_type maximum(bool nested) {\n  const Set outer;\n  if (nested) {\n    const Set inner;\n    return inner.max_size() - outer.max_bucket_count();\n  }\n  return outer.max_size();\n}\nint main() { return maximum(true) != 0 || maximum(false) != Set::size_type(-1) / 24; }\n",
      "source_sha256": "0e0622d95993de087ed2850db140e579db8e4f4f6a8959b2744e2ad414d1b1d3"
    },
    {
      "name": "unordered-empty-capacity-nonempty-owner",
      "expected": "accept",
      "public_header": "unordered_set",
      "kind": "cpp17-operation",
      "source": "#include <unordered_set>\nint main() {\n  const std::unordered_multiset<int> values{3, 3};\n  return values.max_size() == 0;\n}\n",
      "source_sha256": "9410245a4e9c6eaf36b49306da04f8d4940089fec17fef807e2e8f4a628afbdb"
    },
    {
      "name": "unordered-empty-capacity-arrow-receiver",
      "expected": "accept",
      "public_header": "unordered_set",
      "kind": "cpp17-operation",
      "source": "#include <unordered_set>\nint main() {\n  const std::unordered_set<int> values;\n  const auto* pointer = &values;\n  return pointer->max_bucket_count() == 0;\n}\n",
      "source_sha256": "ef89b1775b5c94bcbe0242b039a33e5a73872a7804e572f78132ea04bd45e5e6"
    },
    {
      "name": "unordered-empty-capacity-custom-hash",
