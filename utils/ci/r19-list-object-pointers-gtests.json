  "source_cases": [
    {
      "name": "list-object-pointer-sorting-keeps-stored-slot",
      "expected": "accept",
      "source": "#include <list>\nint main() {\n  int data[] = {11, 22, 33};\n  std::list<int*> pointers{&data[2], &data[0]};\n  auto old = pointers.begin();\n  int** slot = &*old;\n  pointers.sort();\n  if (pointers.front() != &data[0] || pointers.back() != &data[2] || &pointers.back() != slot)\n    return 1;\n  *old = &data[1];\n  **old = 42;\n  return pointers.back() != &data[1] || data[1] != 42 || data[2] != 33;\n}\n",
      "source_sha256": "7148e542616dde356041b245d016681fa54af04901430b2d1ceeed25e3eedb19",
      "public_header": "list",
      "kind": "cpp17-operation"
    },
    {
      "name": "list-const-pointee-range-copies-pointer-values",
      "expected": "accept",
      "source": "#include <list>\nint main() {\n  const char data[] = {'a', 'b', 'c'};\n  const char* input[] = {data, data + 2};\n  std::list<const char*> pointers(input, input + 2);\n  input[0] = data + 1;\n  const auto& observed = pointers;\n  auto cursor = observed.crbegin();\n  if (*cursor != &data[2] || **cursor != 'c')\n    return 1;\n  ++cursor;\n  return *cursor != &data[0] || **cursor != 'a' || pointers.size() != 2;\n}\n",
      "source_sha256": "2169c2f988d1c0c143fdb47aa96c9ab0c64f2f6926717e7151a744d8716d5e9d",
      "public_header": "list",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-const-pointer-assignment-and-null-resize",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  const int data[] = {5, 8};\n  const int* const input[] = {data, data + 1};\n  std::forward_list<const int*> pointers;\n  pointers.assign(input, input + 2);\n  pointers.resize(3);\n  auto item = pointers.cbegin();\n  return *item++ != &data[0] || *item++ != &data[1] || *item++ != nullptr || item != pointers.cend();\n}\n",
      "source_sha256": "92f8b83c86f67dccdcba10aa45ff1e5620597911641fb9a66e27ede81efa759f",
      "public_header": "forward_list",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-pointer-merge-keeps-node-and-pointee",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  double data[] = {1.5, 2.5, 3.5};\n  std::forward_list<double*> left{data, data + 2}, right{data + 1};\n  auto saved = right.begin();\n  double** slot = &*saved;\n  left.merge(right);\n  auto item = left.begin();\n  if (!right.empty() || *item++ != data || item != saved || &*item != slot)\n    return 1;\n  **item++ = 4.25;\n  return *item++ != data + 2 || item != left.end() || data[1] != 4.25;\n}\n",
      "source_sha256": "287ce13f1e92aabe41920c74efb1a70b0b646b6480acfdf5db7015cb445bca3d",
      "public_header": "forward_list",
      "kind": "cpp17-operation"
    },
    {
      "name": "list-function-pointer-element-guard",
      "expected": "reject",
      "source": "#include <list>\nint identity(int value) { return value; }\nint main() {\n  std::list<int (*)(int)> callbacks{&identity};\n  return callbacks.front()(7) != 7;\n}\n",
      "source_sha256": "cc173dac050cee629137d374b537c6b430a4ddc4fda70c4ed0fb0bf8dc9f1222",
