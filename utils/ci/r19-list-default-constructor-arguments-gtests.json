  "source_cases": [
    {
      "name": "list-two-default-constructor-parameters-resize",
      "section": "list",
      "source": "#include <list>\nstruct Entry {\n  int value;\n  Entry(short first = 5, int second = 3 * 7) noexcept : value(first + second) {}\n};\nint main() {\n  std::list<Entry> rows(2);\n  auto& before = rows.front();\n  rows.resize(3);\n  auto& added = rows.emplace_front();\n  return rows.size() != 4 || &added != &rows.front() || before.value != 26 || rows.back().value != 26;\n}\n",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source_sha256": "4376477020729824246624ff05db9189f61f883d4ea4ee3ef194ac5759e2d4c9"
    },
    {
      "name": "forward-list-default-constructor-parameter-emplace",
      "section": "forward_list",
      "source": "#include <forward_list>\nstruct Entry {\n  unsigned value;\n  explicit Entry(unsigned initial = 3) noexcept : value(initial) {}\n};\nint main() {\n  std::forward_list<Entry> rows;\n  auto first = rows.emplace_after(rows.before_begin());\n  rows.resize(3);\n  auto second = first;\n  ++second;\n  return &*first != &rows.front() || first->value != 3 || second->value != 3;\n}\n",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source_sha256": "1d3eba1657c8601a9cdc115236e72fc6221a9268adfb3f88965f1f9dee00e221"
    },
    {
      "name": "forward-list-nested-default-constructor-parameters",
      "section": "forward_list",
      "source": "#include <forward_list>\nstruct Item {\n  int id;\n  Item(int initial = 7) noexcept : id(initial) {}\n};\nstruct Row {\n  Item items[2];\n  int count = 2;\n};\nint main() {\n  std::forward_list<Row> rows(1);\n  auto first = rows.begin();\n  rows.resize(2);\n  auto second = first;\n  ++second;\n  return first->items[0].id != 7 || second->items[1].id != 7 || second->count != 2;\n}\n",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source_sha256": "599d1dbf965c025e1d7db91f30948727cb6c377a8365d99ea04988b5eae36e11"
    },
    {
      "name": "list-default-constructor-reference-parameter-guard",
      "section": "list",
      "source": "#include <list>\nint initial = 4;\nstruct Entry {\n  int value;\n  Entry(const int& number = initial) noexcept : value(number) {}\n};\nint main() {\n  std::list<Entry> rows(1);\n  return rows.front().value != 4;\n}\n",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source_sha256": "d2357979dbb5a54cfe063c11ef9daabb99b126c8998d338382f3db40156df1e3"
    },
    {
      "name": "forward-list-default-constructor-side-effect-parameter-guard",
      "section": "forward_list",
      "source": "#include <forward_list>\nint calls;\nint initial() { return ++calls; }\nstruct Entry {\n  int value;\n  Entry(int number = initial()) noexcept : value(number) {}\n};\nint main() {\n  std::forward_list<Entry> rows(2);\n  return rows.front().value != 1 || calls != 2;\n}\n",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source_sha256": "f00fe848f172c28f7694e93f8d5e677893d9ab2d006ecff57e3e40d658ec4c1d"
    }
