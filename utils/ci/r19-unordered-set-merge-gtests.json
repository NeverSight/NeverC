  "source_cases": [
    {
      "name": "unordered-set-merge-unique-merge-preserves-node-and-rejected-duplicate-addresses",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> target{5, 7};\n  std::unordered_set<int> source{5, 13, 19};\n  const int* moved = &*source.find(13);\n  const int* duplicate = &*source.find(5);\n  target.merge(source);\n  return target.size() != 4 || source.size() != 1 || &*target.find(13) != moved ||\n         &*source.find(5) != duplicate || target.count(19) != 1 || source.count(19) != 0;\n}\n",
      "source_sha256": "a0b4b69e0f1dabbda58a70c63686671233d770b7730947d83a8500f02296ff6e",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-merge-unique-merges-one-copy-from-each-new-multiset-key",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> target{3};\n  std::unordered_multiset<int> source{3, 5, 3, 5, 7, 7, 7};\n  target.merge(source);\n  return target.size() != 3 || target.count(5) != 1 || target.count(7) != 1 ||\n         source.count(3) != 2 || source.count(5) != 1 || source.count(7) != 2 || source.size() != 5;\n}\n",
      "source_sha256": "b09867324796144b3bbb9bdb2c06325b3bebffe269b41b5ce1f5a6204935897c",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-merge-multi-merges-rvalue-unique-owner-without-reallocating-nodes",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\n#include <utility>\nint main() {\n  std::unordered_multiset<int> target{9, 9};\n  std::unordered_set<int> source{9, 23, -1};\n  const int* moved = &*source.find(23);\n  auto* receiver = &target;\n  receiver->merge(std::move(source));\n  return !source.empty() || target.size() != 5 || target.count(9) != 3 ||\n         target.count(-1) != 1 || &*target.find(23) != moved;\n}\n",
      "source_sha256": "b1cda2b87c7d42c9e80cb1d61f5f5763068af94271cedb1ba3db4f014d5d152f",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-merge-multi-merge-groups-equivalent-keys-in-colliding-bucket",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> target;\n  target.rehash(2);\n  target.max_load_factor(4.0f);\n  target.insert({3, 7, 7});\n  std::unordered_multiset<int> source{3, 5, 3, 7};\n  target.merge(source);\n  auto group = target.equal_range(3);\n  int matches = 0;\n  for (auto it = group.first; it != group.second; ++it) {\n    if (*it != 3) return 1;\n    ++matches;\n  }\n  return !source.empty() || target.size() != 7 || matches != 3 ||\n         target.count(5) != 1 || target.count(7) != 3 || target.bucket_count() != 2;\n}\n",
      "source_sha256": "9bcdaa72b78494ad60b6a8fc117ad5be8f39f8dcbfe78d4ff4c36903aeec3889",
      "kind": "cpp17-operation"
    },
