    {
      "name": "forward-list-emplace-after-converts-const-short",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  const short value = -320;\n  std::forward_list<int> list{5, 6};\n  auto selected = list.emplace_after(list.cbegin(), value);\n  auto item = list.begin();\n  if (*item++ != 5 || item != selected || *item++ != -320)\n    return 1;\n  return *item++ != 6 || item != list.end();\n}\n",
      "source_sha256": "e1709f5bc2c26052881ea9727970c17b5435174317c0816f6821babd2340e8d7",
      "public_header": "forward_list",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-long-emplace-front-preserves-source-evaluation",
      "expected": "accept",
      "source": "#include <forward_list>\nint calls = 0;\nint next() { ++calls; return -289; }\nint main() {\n  std::forward_list<long> list{9L};\n  long &result = list.emplace_front(next());\n  if (calls != 1 || &result != &list.front() || result != -289L)\n    return 1;\n  result = 700L;\n  auto item = list.cbegin();\n  return *item++ != 700L || *item++ != 9L || item != list.cend();\n}\n",
      "source_sha256": "776ad620e6aad2cf6022ca508b01d26d5e2869be3d7e258dc789195921c4ecd8",
      "public_header": "forward_list",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-emplace-front-converts-mutable-long",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  long value = -45L;\n  std::forward_list<int> list;\n  int &result = list.emplace_front(value);\n  value = 19L;\n  return &result != &list.front() || result != -45 || value != 19L;\n}\n",
      "source_sha256": "c98177f106b7c148a69919b9c5cf51b90615e2cfcdcecd040d87e487bb4da0f7",
      "public_header": "forward_list",
      "kind": "cpp17-operation"
    },
