      "source": "#include <variant>\nusing V = std::variant<int, double>;\nint read(const V& state) {\n  if (!std::holds_alternative<int>(state)) return -1;\n  return std::get<int>(state);\n}\nint main() {\n  const V normal{18};\n  const V different{3.5};\n  return read(normal) != 18 || read(different) != -1;\n}\n",
      "source_sha256": "1b55eeb9ba1f4ea8f6d13eba5b4845743bfbc6a3e94c8552a3872b4b088b8321"
    },
    {
      "name": "variant-get-early-return-returns-on-different-index",
      "expected": "accept",
      "public_header": "variant",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing V = std::variant<int, int>;\nint update(V& state) {\n  if (state.index() != 1) { return -1; }\n  int& value = std::get<1>(state);\n  return ++value;\n}\nint main() {\n  V wrong(std::in_place_index<0>, 4);\n  V right(std::in_place_index<1>, 7);\n  return update(wrong) != -1 || update(right) != 8 || *std::get_if<1>(&right) != 8;\n}\n",
      "source_sha256": "e2ea774c9abf719144536ae9c161d03545c85c9eb48e7260dcea5c13d912062f"
    },
    {
      "name": "variant-get-early-return-checked-else-branch",
      "expected": "accept",
      "public_header": "variant",
      "kind": "cpp17-operation",
      "source": "#include <variant>\nusing V = std::variant<std::monostate, long>;\nlong read(V& state) {\n  if (state.index() != 1) return -1;\n  else {\n    auto& hold = std::get<1>(state);\n    hold += 3;\n    return hold;\n  }\n}\nint main() {\n  V inactive;\n  V active{6L};\n  return read(inactive) != -1 || read(active) != 9L;\n}\n",
      "source_sha256": "6adf0d8cdf1548a5a405a8f32503a1aa83ada598a1154abde8872ace6595d295"
    },
