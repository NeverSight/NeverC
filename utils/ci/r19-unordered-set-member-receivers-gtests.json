  "source_cases": [
    {
      "name": "unordered-set-member-receivers-pointer-range-evaluates-bucket-count-once-before-inserting",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nstatic unsigned calls;\nunsigned count() { ++calls; return 31; }\nint main() {\n  const int input[] = {7, 2, 7, 5};\n  std::unordered_set<int> values(input, input + 4, count());\n  return calls != 1 || values.bucket_count() < 31 || values.size() != 3 || values.count(7) != 1;\n}\n",
      "source_sha256": "0ffbac52379697fdca66f0eec76599e3bc23aef86f151c49cfb19f6d52ae46c7",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-member-receivers-iterator-range-with-pinned-policies-retains-equivalent-keys",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> source{5, 5, 6};\n  std::unordered_multiset<int> values(source.cbegin(), source.cend(), 32, std::hash<int>{},\n      std::equal_to<int>{}, std::allocator<int>{});\n  source.clear();\n  return values.bucket_count() < 32 || values.size() != 3 || values.count(5) != 2;\n}\n",
      "source_sha256": "f2775b0cbf47f102d9a20650f2487584e99fd1bb6d4c2e8d91bb394cac126ffa",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-member-receivers-list-with-bucket-count-and-allocator-coalesces-duplicates",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> values({2, 8, 2}, 17, std::allocator<int>{});\n  return values.bucket_count() < 17 || values.size() != 2 || values.count(2) != 1;\n}\n",
      "source_sha256": "7743fc7780e1d1102ac3b4b4c8eeba57680168cdb79104a47f616f48238bd548",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-member-receivers-list-with-all-policies-preserves-duplicate-key-group",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> values({7, 3, 7}, 11, std::hash<int>{},\n      std::equal_to<int>{}, std::allocator<int>{});\n  return values.bucket_count() < 11 || values.size() != 3 || values.count(7) != 2;\n}\n",
      "source_sha256": "8fa731cfe5fa56f6e6a4bbcacf597f94de825ec8a33f1c19003e3e3ea4203f92",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-member-receivers-empty-range-keeps-explicit-bucket-storage",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  int input = 5;\n  std::unordered_multiset<int> values(&input, &input, 16, std::allocator<int>{});\n  return !values.empty() || values.bucket_count() < 16;\n}\n",
      "source_sha256": "a7e6953350cf547933f3989d425e6e38946a6cda5658b7846ff5fd5d49ae0b6e",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-member-receivers-member-pointer-expressions-evaluate-once",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Set = std::unordered_set<int>;\nSet* table(Set& values, unsigned& calls) { ++calls; return &values; }\nint main() {\n  Set values{3};\n  unsigned calls = 0;\n  if (!table(values, calls)->emplace(4).second) return 1;\n  auto found = table(values, calls)->find(3);\n  if (found == values.end() || *found != 3) return 2;\n  table(values, calls)->erase(found);\n  return calls != 3 || values.size() != 1 || values.count(4) != 1;\n}\n",
      "source_sha256": "7865d5d0157d879fefb3f970af6448168e0e6b65b486bfa7b8af749fe08b0e63",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-member-receivers-const-pointer-global-and-local-iteration",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> values{3, 3, 7};\n  values.rehash(16);\n  const auto* pointer = &values;\n  const auto group = pointer->equal_range(3);\n  const auto bucket = values.bucket(3);\n  unsigned global = 0, local = 0;\n  for (auto it = group.first; it != group.second; ++it) global += *it;\n  for (auto it = pointer->cbegin(bucket); it != pointer->cend(bucket); ++it) local += *it;\n  return global != 6 || local != 6 || pointer->count(3) != 2;\n}\n",
      "source_sha256": "8f419792511c409a6582142a7a4a59e33a13d3afd476cd028514f44a3516ff68",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-member-receivers-pointer-range-insertion-and-clear-preserve-key-multiplicity",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> source{4, 4, 8}, target{4};\n  auto* receiver = &target;\n  receiver->insert(source.cbegin(), source.cend());\n  if (receiver->count(4) != 3 || receiver->erase(8) != 1) return 1;\n  receiver->clear();\n  return !target.empty() || source.count(4) != 2;\n}\n",
      "source_sha256": "13c6988d3b64db4b7b3bc5d6d73c1a35d83a399d436ee8a08fc6d013431474d7",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-member-receivers-pointer-swap-retains-element-address-and-live-buckets",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> left{4, 5}, right{8};\n  left.reserve(16);\n  const int* address = &*left.find(5);\n  auto* receiver = &left;\n  receiver->swap(right);\n  return receiver->count(8) != 1 || right.bucket_count() < 16 || &*right.find(5) != address;\n}\n",
      "source_sha256": "5e9bccbac7437b3a5656437e8d941d698d2d959f8e7943fff31730bc6a0c4029",
      "kind": "cpp17-operation"
    },
