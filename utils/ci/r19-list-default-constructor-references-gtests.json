  "source_cases": [
    {
      "name": "forward-list-default-constructor-shares-global-reference",
      "section": "forward_list",
      "expected": "accept",
      "source": "#include <forward_list>\nint state = 2;\nstruct Entry {\n  int* source;\n  int before;\n  Entry(int& initial = state) noexcept : source(&initial), before(initial++) {}\n};\nint main() {\n  std::forward_list<Entry> rows(1);\n  auto first = rows.begin();\n  rows.resize(2);\n  auto second = first;\n  ++second;\n  auto after = rows.emplace_after(second);\n  return first->source != &state || second->before != 3 || after->before != 4 || state != 5;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "172f642ba6b729326e54d2543da7eca18719876f9bdd91754172be1e85915d9a"
    },
    {
      "name": "list-default-constructor-reference-and-value",
      "section": "list",
      "expected": "accept",
      "source": "#include <list>\nstatic int source = 7;\nstruct Entry {\n  const int* reference;\n  int value;\n  Entry(short bias = 5, const int& initial = source) noexcept\n    : reference(&initial), value(initial + bias) {}\n};\nint main() {\n  std::list<Entry> rows(1);\n  source = 9;\n  auto& appended = rows.emplace_back();\n  return rows.front().value != 12 || appended.value != 14 ||\n         appended.reference != &source || *rows.front().reference != 9;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "3ebdc2252919eab2159054d085e2ecff403de7921650e5ce218734e314ad43f0"
    },
    {
      "name": "list-nested-default-constructor-global-reference",
      "section": "list",
      "expected": "accept",
      "source": "#include <list>\nint initial = 5;\nstruct Value {\n  int* reference;\n  int previous;\n  Value(int& input = initial) noexcept : reference(&input), previous(input++) {}\n};\nstruct Entry { Value values[2]; };\nint main() {\n  std::list<Entry> rows(1);\n  rows.resize(2);\n  return initial != 9 || rows.front().values[0].previous != 5 ||\n         rows.back().values[1].previous != 8 || rows.back().values[1].reference != &initial;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "5ee55ec6ae73fdf2fbec5b2bc127dc1eb2a505f14c4079f0fe2fb78478403202"
    },
