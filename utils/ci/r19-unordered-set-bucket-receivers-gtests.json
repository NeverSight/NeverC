  "source_cases": [
    {
      "name": "unordered-set-bucket-receivers-capacity-constants-evaluate-the-const-pointer-receiver",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Set = std::unordered_set<int>;\nconst Set* observe(const Set& values, int& calls) { ++calls; return &values; }\nint main() {\n  const Set values{2, 3};\n  int calls = 0;\n  const auto keys = observe(values, calls)->max_size();\n  const auto buckets = observe(values, calls)->max_bucket_count();\n  return calls != 2 || keys < 2 || buckets < values.bucket_count();\n}\n",
      "source_sha256": "feb1e6477e10d6cf1dfb16b554e8e334c90184cc6e66c7eeccc3fba43a01e212",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-bucket-receivers-pointer-capacity-and-load-observers-use-the-live-table",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  const std::unordered_multiset<int> values{3, 3, 7};\n  const auto* p = &values;\n  return p->empty() || p->size() != 3 || p->bucket_count() != values.bucket_count() ||\n         p->load_factor() != values.load_factor() || p->max_load_factor() != 1.0f;\n}\n",
      "source_sha256": "32f86e8bfae9bece2859df4f7f82bbb63e80c9b1325c4a18edf3bb7a2e82a7a6",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-bucket-receivers-pointer-reserve-and-rehash-evaluate-the-receiver-once",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Set = std::unordered_multiset<int>;\nSet* observe(Set& values, int& calls) { ++calls; return &values; }\nint main() {\n  Set values{7, 7, 5};\n  int calls = 0;\n  observe(values, calls)->reserve(19);\n  if (values.bucket_count() < 19) return 1;\n  observe(values, calls)->rehash(37);\n  return calls != 2 || values.bucket_count() < 37 || values.count(7) != 2;\n}\n",
      "source_sha256": "bb6bd8fc69b3e320e7532aac7e523a84ef03d49d300a4409155b9a2c39e657c4",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-bucket-receivers-pointer-bucket-and-size-find-an-equivalent-key-group",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> values{1, 1, 2};\n  values.rehash(8);\n  const auto* p = &values;\n  const auto bucket = p->bucket(1);\n  return bucket >= p->bucket_count() || p->bucket_size(bucket) != 2;\n}\n",
      "source_sha256": "f1b29ac30979f01b5b2a488fcb1c247b3b2afdc2c20361f26ca94b1bfac28ff2",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-bucket-receivers-pointer-setter-preserves-the-live-load-limit",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Set = std::unordered_set<int>;\nSet* observe(Set& values, int& calls) { ++calls; return &values; }\nint main() {\n  Set values{1, 2};\n  const auto load = values.load_factor();\n  int calls = 0;\n  observe(values, calls)->max_load_factor(load / 2);\n  return calls != 1 || values.max_load_factor() != load || values.size() != 2;\n}\n",
      "source_sha256": "000f38108569427038c1f938944e7be7a55b84e6f9fba3dbef24cf5c34a564da",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-bucket-receivers-other-key-pointer-capacity-observer",
      "expected": "reject",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  const std::unordered_set<long> values;\n  const auto* p = &values;\n  return p->max_bucket_count() == 0;\n}\n",
      "source_sha256": "c70c997eb7a4984764c0e7e909352c99cb7a854947a9e3c89abcad59d9164f48",
      "kind": "source-body-guard"
    },
    {
      "name": "unordered-set-bucket-receivers-custom-hash-pointer-rehash",
      "expected": "reject",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nstruct Hash { unsigned long operator()(int key) const { return static_cast<unsigned>(key); } };\nint main() {\n  std::unordered_multiset<int, Hash> values;\n  auto* p = &values;\n  p->rehash(5);\n  return values.empty();\n}\n",
      "source_sha256": "eb4fd3b13727615efa8ff7126363f5dde4df9128e132894157b3f62e32842473",
      "kind": "source-body-guard"
    },
    {
      "name": "unordered-set-bucket-receivers-custom-equality-pointer-load-limit",
      "expected": "reject",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nstruct Equal { bool operator()(int x, int y) const { return x == y; } };\nint main() {\n  std::unordered_set<int, std::hash<int>, Equal> values;\n  auto* p = &values;\n  p->max_load_factor(2.0f);\n  return p->size();\n}\n",
      "source_sha256": "7d764c118d4c798bb6ff91d65de4c1072cbaa92521c4a1ea3ef31ba032b188bd",
