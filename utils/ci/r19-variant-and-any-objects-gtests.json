  "source_cases": [
    {
      "name": "variant-visit-mutable-reference-result-aliases-payload",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <variant>\nint& identity(int& value) { return value; }\nint main() {\n  std::variant<int> value{2};\n  int& slot = std::visit(identity, value);\n  auto* address = &slot;\n  slot = 8;\n  auto* active = std::get_if<0>(&value);\n  return address != active || !active || *active != 8;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "e182d9ed328aaf2fb7595c9ded97de135d9999be9cc34dd94a389fde96dea5e9"
    },
    {
      "name": "variant-visit-const-reference-result-selects-overload",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <variant>\nstruct Visitor {\n  double backing;\n  const double& operator()(const double& value) const { return value; }\n  const double& operator()(const int&) const { return backing; }\n};\nint main() {\n  using Value = std::variant<double, int>;\n  const Value direct{3.5}, fallback{7};\n  const Visitor visitor{8.5};\n  auto* active = std::get_if<0>(&direct);\n  const double& selected = std::visit(visitor, direct);\n  const double& other = std::visit(visitor, fallback);\n  return !active || &selected != active || &other != &visitor.backing || selected != 3.5 || other != 8.5;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "1e625ebcc6e969c0d858d10c3bd8186d7ed09e1ffbc0eee5261b556ce1f88e44"
    },
    {
      "name": "variant-visit-rvalue-reference-result-preserves-identity",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <variant>\nint&& select(int& value) { return static_cast<int&&>(value); }\nint main() {\n  std::variant<int> value{4};\n  auto&& slot = std::visit(select, value);\n  auto* active = std::get_if<0>(&value);\n  slot = 12;\n  return !active || &slot != active || *active != 12;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "e5e1be6ff9d00f5de1421057ede4f628a4852f48b5890efb32d0ce39e1777874"
    },
    {
      "name": "any-repeated-active-value-and-reference-casts",
      "public_header": "any",
      "expected": "accept",
      "source": "#include <any>\nint main() {\n  std::any value{4};\n  int before = std::any_cast<int>(value);\n  int& slot = std::any_cast<int&>(value);\n  slot = 9;\n  return before != 4 || std::any_cast<int>(value) != 9;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "4dd664169c180ae0bc5bf0e349ce730ce42defadd6b82a2726924f1516b14822"
    },
    {
      "name": "any-repeated-active-casts-reference-same-slot",
      "public_header": "any",
      "expected": "accept",
      "source": "#include <any>\nint main() {\n  std::any value{true};\n  bool& slot = std::any_cast<bool&>(value);\n  const bool& read = std::any_cast<const bool&>(value);\n  slot = false;\n  return &read != &slot || read;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "80ee590b14e30c0f31ff917d68447bd9ee42c598a0febcc7a2134034d8fa4d5b"
    },
    {
      "name": "any-repeated-active-cast-in-loop",
