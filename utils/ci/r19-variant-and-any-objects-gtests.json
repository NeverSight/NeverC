    {
      "name": "variant-trivial-aggregate-in-place-copy-preserves-members",
      "public_header": "variant",
      "expected": "accept",
      "source": "#include <variant>\nstruct Payload { int count; double amount; };\nint main() {\n  Payload original{7, 4.5};\n  std::variant<int, Payload> value{std::in_place_type<Payload>, original};\n  original.count = 9;\n  auto* active = std::get_if<1>(&value);\n  return !active || active->count != 7 || active->amount != 4.5 || value.index() != 1;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "9e5c69703f1fe59d571ee8ba0f3395c3651121ed470726075b8d92950701f22c"
