    {
      "name": "list-record-default-call-resize",
      "section": "list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <list>\nint calls;\nint next() { return ++calls; }\nstruct Entry { int serial = next(); int checksum = serial * 10; };\nint main() {\n  std::list<Entry> rows(2);\n  auto first = rows.begin();\n  rows.resize(4);\n  if (calls != 4 || first != rows.begin() || first->checksum != 10 || rows.back().checksum != 40) return 1;\n  rows.resize(1);\n  return calls != 4 || first != rows.begin() || rows.back().serial != 1;\n}\n",
      "source_sha256": "9209ff55f91ab678ce92278cefbcd355ea2c58a34f077269419782763855cbc4"
    },
    {
      "name": "forward-list-record-default-call-emplacement",
      "section": "forward_list",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source": "#include <forward_list>\nint calls;\nint next() { return ++calls; }\nstruct Entry { int id = next() + 4; int tag = next(); };\nint main() {\n  std::forward_list<Entry> rows(1);\n  auto first = rows.begin();\n  if (first->id != 5 || first->tag != 2) return 1;\n  auto second = rows.emplace_after(first);\n  rows.emplace_front();\n  return calls != 6 || rows.front().id != 9 || rows.front().tag != 6 ||\n         second->id != 7 || second->tag != 4 || first->id != 5;\n}\n",
      "source_sha256": "21ccc332ca63c0d7d9f84525d2a20d62e87a3b2719519b958d8b11a3bf35290c"
    },
    {
      "name": "list-record-default-call-aggregate-suppression",
