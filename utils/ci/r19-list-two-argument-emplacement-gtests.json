    {
      "name": "forward-list-two-scalar-emplace-with-destruction",
      "section": "forward_list",
      "expected": "accept",
      "source": "#include <forward_list>\nint calls, removed;\nint next() { return ++calls; }\nstruct Entry {\n  int value;\n  Entry() noexcept : value(0) {}\n  Entry(int a, int b) noexcept : value(a + b) {}\n  ~Entry() noexcept { removed += value; }\n};\nint main() {\n  std::forward_list<Entry> rows;\n  auto& value = rows.emplace_front(next(), 5);\n  if (calls != 1 || value.value != 6 || removed) return 1;\n  rows.pop_front();\n  return calls != 1 || removed != 6;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "75a32c3de42a26a4af96d9d17a327561995844be6726b2df7155d325d960a7ec"
    },
