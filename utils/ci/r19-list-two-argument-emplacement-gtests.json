    {
      "name": "list-two-scalar-emplace-back",
      "section": "list",
      "expected": "accept",
      "source": "#include <list>\nstruct Entry {\n  int key, value;\n  Entry() noexcept : key(0), value(0) {}\n  Entry(short k, int v) noexcept : key(k), value(v) {}\n};\nint main() {\n  std::list<Entry> rows;\n  short k = 3;\n  auto& out = rows.emplace_back(k, 11);\n  return &out != &rows.front() || out.key != 3 || out.value != 11;\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "815785d91f9318aed374fce0f2a3070e7cc008f8d0955b747414ca1a940fdc20"
    },
    {
      "name": "forward-list-two-scalar-emplace-after",
      "section": "forward_list",
      "expected": "accept",
      "source": "#include <forward_list>\nstruct Entry {\n  int first, second;\n  Entry() noexcept : first(0), second(0) {}\n  Entry(int a, int b) noexcept : first(a), second(b) {}\n};\nint main() {\n  std::forward_list<Entry> rows;\n  const int b = 8;\n  auto out = rows.emplace_after(rows.before_begin(), 3, b);\n  auto next = out;\n  ++next;\n  return out != rows.begin() || out->first != 3 || out->second != 8 || next != rows.end();\n}\n",
      "kind": "cpp17-operation",
      "source_sha256": "c46dc6763beb3d8a6ed73c59b374dadf8e88e2b12fe0a5c2687068005ca0f290"
    },
    {
      "name": "list-two-scalar-emplace-position-overload",
