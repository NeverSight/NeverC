      "name": "forward-list-count-construction-value-initializes",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  std::forward_list<int> list(4);\n  auto cursor = list.begin();\n  for (int index = 0; index != 4; ++index, ++cursor) {\n    if (cursor == list.end() || *cursor != 0)\n      return 1;\n    *cursor = index + 1;\n  }\n  return cursor != list.end() || list.front() != 1;\n}\n",
      "public_header": "forward_list",
      "source_sha256": "89d0b849d56c9a80af395f35cd962697350483a2504dc3df8db1fcc56285ce6e",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-fill-construction-copies-value",
      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  int value = 7;\n  std::forward_list<int> list(3, value);\n  std::forward_list<int> empty(0, value);\n  value = 13;\n  auto cursor = list.begin();\n  for (int index = 0; index != 3; ++index, ++cursor)\n    if (cursor == list.end() || *cursor != 7)\n      return 1;\n  return cursor != list.end() || !empty.empty() || value != 13;\n}\n",
      "public_header": "forward_list",
      "source_sha256": "6b091837aced99837859438187da9ad5527ec3a11ae7efca065610951feb9b49",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-count-construction-with-default-allocator",
      "expected": "accept",
      "source": "#include <forward_list>\n#include <memory>\nint main() {\n  const std::allocator<int> allocator;\n  std::forward_list<int> zeros(2, allocator);\n  std::forward_list<int> values(3, 11, allocator);\n  auto zero = zeros.begin();\n  if (*zero != 0 || *++zero != 0 || ++zero != zeros.end())\n    return 1;\n  auto cursor = values.begin();\n  if (*cursor != 11 || *++cursor != 11 || *++cursor != 11)\n    return 2;\n  return ++cursor != values.end();\n}\n",
      "public_header": "forward_list",
      "source_sha256": "091ff6bef9808da3a81b4021d8eb355f6c47df39a80dbe58d123d516fbd9bd33",
