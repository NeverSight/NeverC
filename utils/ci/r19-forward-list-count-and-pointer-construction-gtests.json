      "expected": "accept",
      "source": "#include <forward_list>\nint main() {\n  std::forward_list<int> list(4);\n  auto cursor = list.begin();\n  for (int index = 0; index != 4; ++index, ++cursor) {\n    if (cursor == list.end() || *cursor != 0)\n      return 1;\n    *cursor = index + 1;\n  }\n  return cursor != list.end() || list.front() != 1;\n}\n",
      "public_header": "forward_list",
      "source_sha256": "89d0b849d56c9a80af395f35cd962697350483a2504dc3df8db1fcc56285ce6e",
      "kind": "cpp17-operation"
    },
