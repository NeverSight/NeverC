  "source_cases": [
    {
      "name": "unordered-set-observers-set-allocator-allocates-and-releases-integer-storage",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  const std::unordered_set<int> values{9, 17};\n  auto allocator = values.get_allocator();\n  auto* storage = allocator.allocate(1);\n  const bool allocated = storage != nullptr;\n  allocator.deallocate(storage, 1);\n  return !allocated || values.count(9) != 1;\n}\n",
      "source_sha256": "a78f2758c5f17a0a83555b582472ba74f2cd25ffd5666fe468847c24ad08c9ee",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-observers-multiset-allocator-evaluates-arrow-receiver-once",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Set = std::unordered_multiset<int>;\nconst Set* observe(const Set& values, int& calls) { ++calls; return &values; }\nint main() {\n  const Set values{5, 5};\n  int calls = 0;\n  auto allocator = observe(values, calls)->get_allocator();\n  auto* storage = allocator.allocate(2);\n  const bool allocated = storage != nullptr;\n  allocator.deallocate(storage, 2);\n  return !allocated || calls != 1 || values.count(5) != 2;\n}\n",
      "source_sha256": "1230975ba65a31a1ff247cb2e17ede931bd219c162b87e37ada4a4e91c2fe092",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-observers-hash-function-on-arrow-receiver-uses-pinned-signed-hash",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <cstddef>\n#include <unordered_set>\nint main() {\n  const std::unordered_set<int> values{-9, 7};\n  const auto* receiver = &values;\n  const auto hash = receiver->hash_function();\n  return hash(-9) != static_cast<std::size_t>(-9) || hash(7) != 7u || values.count(-9) != 1;\n}\n",
      "source_sha256": "e4c5deef4b4099f47b32a6827fe13d35762827e12ef476cffd7c34b9f00244d7",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-observers-key-equality-on-arrow-receiver-compares-default-integer-keys",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  const std::unordered_multiset<int> values{3, 3, -1};\n  const auto* receiver = &values;\n  const auto equal = receiver->key_eq();\n  return !equal(-1, -1) || equal(-1, 3) || values.count(3) != 2;\n}\n",
      "source_sha256": "de372121265841defb79d343629e4b961d22bd2cd9f76a2b0957fc206602af7d",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-observers-custom-hash-arrow-observer",
      "expected": "reject",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nstruct Hash { unsigned long operator()(int key) const { return static_cast<unsigned>(key); } };\nint main() {\n  const std::unordered_set<int, Hash> values;\n  const auto* receiver = &values;\n  return receiver->hash_function()(7) != 7u;\n}\n",
      "source_sha256": "a644615b6ebdbaddd340f4be8f6774164208127adf3125ba456fb50f2dfaa82d",
      "kind": "source-body-guard"
    },
    {
      "name": "unordered-set-observers-custom-equality-arrow-observer",
      "expected": "reject",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nstruct Equal { bool operator()(int left, int right) const { return left == right; } };\nint main() {\n  const std::unordered_multiset<int, std::hash<int>, Equal> values;\n  const auto* receiver = &values;\n  return receiver->key_eq()(1, 2);\n}\n",
      "source_sha256": "4b68b530809b13f9c0523bc061bf81d067b2dab2e261a4f4d1b1ed7a4416db48",
      "kind": "source-body-guard"
    },
