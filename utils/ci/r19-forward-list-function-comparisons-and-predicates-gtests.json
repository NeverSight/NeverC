  "source_cases": [
    {
      "name": "forward-list-order-function-keeps-stability-and-nodes",
      "expected": "accept",
      "source": "#include <forward_list>\nbool descending(int a, int b) { return a > b; }\nint main() {\n  std::forward_list<int> left{1, 7, 3, 3}, right{5, 3};\n  auto first_three = left.begin();\n  ++first_three;\n  ++first_three;\n  auto next_three = first_three;\n  ++next_three;\n  auto other_three = right.begin();\n  ++other_three;\n  left.sort(&descending);\n  left.merge(right, descending);\n  auto it = left.begin();\n  if (!right.empty() || *it != 7 || *++it != 5 || ++it != first_three)\n    return 1;\n  if (++it != next_three || ++it != other_three || *++it != 1)\n    return 2;\n  return ++it != left.end();\n}\n",
      "public_header": "forward_list",
      "source_sha256": "6f01d508428a7f076682c0276d90d8e5732ad3d960f9cc9e572621d36d716d82",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-remove-predicate-evaluates-once-in-order",
      "expected": "accept",
      "source": "#include <forward_list>\nint trace;\nint calls;\nbool even(int value) {\n  trace = trace * 10 + value;\n  ++calls;\n  return value % 2 == 0;\n}\nusing Predicate = bool (*)(int);\nint selections;\nPredicate select() {\n  ++selections;\n  return even;\n}\nint main() {\n  std::forward_list<int> values{2, 4, 3, 6, 5};\n  auto it = values.begin();\n  ++it;\n  ++it;\n  auto last = it;\n  ++last;\n  ++last;\n  values.remove_if(select());\n  if (selections != 1 || calls != 5 || trace != 24365)\n    return 1;\n  auto cursor = values.begin();\n  return cursor != it || *cursor != 3 || ++cursor != last || *cursor != 5 || ++cursor != values.end();\n}\n",
      "public_header": "forward_list",
      "source_sha256": "af1ff5856db11518926be5e4b78a12208deffcac55c5976dadbc1030860f1af4",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-unique-predicate-keeps-first-and-compares-adjacent-runs",
      "expected": "accept",
      "source": "#include <forward_list>\nint trace;\nint calls;\nbool same_parity(int first, int next) {\n  trace = 100 * trace + 10 * first + next;\n  ++calls;\n  return first % 2 == next % 2;\n}\nint main() {\n  std::forward_list<int> values{2, 4, 5, 7, 6};\n  auto first = values.begin();\n  auto second = first;\n  ++second;\n  ++second;\n  auto third = second;\n  ++third;\n  ++third;\n  values.unique(same_parity);\n  if (calls != 4 || trace != 24255756)\n    return 1;\n  auto it = values.begin();\n  return it != first || *it != 2 || ++it != second || *it != 5 ||\n         ++it != third || *it != 6 || ++it != values.end();\n}\n",
      "public_header": "forward_list",
      "source_sha256": "457213f015e4cd8fda27d61323c5b7caa538c7be5954fff0d1b185e9fbfda7fe",
      "kind": "cpp17-operation"
    },
    {
      "name": "forward-list-sort-observable-function-guard",
      "expected": "reject",
      "source": "#include <forward_list>\nint count;\nbool compare(int a, int b) { ++count; return a < b; }\nint main() {\n  std::forward_list<int> owner{3, 1, 7};\n  owner.sort(compare);\n  return owner.front() != 1 || count == 0;\n}\n",
      "public_header": "forward_list",
      "source_sha256": "f22d103790093bf2b7359152692ff04826d8a8c6d7bf53c76a20665cd0c0a894",
