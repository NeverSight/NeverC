    {
      "name": "forward-list-plain-default-ctor-field-writes",
      "section": "forward_list",
      "source": "#include <forward_list>\nstruct Entry {\n  int first;\n  int second;\n  Entry() : first(2), second(6) {\n    first = second + 1;\n    second *= first;\n    --first;\n  }\n};\nint main() {\n  std::forward_list<Entry> rows(1);\n  auto first = rows.begin();\n  rows.resize(2);\n  auto second = first;\n  ++second;\n  auto after = rows.emplace_after(second);\n  return first->first != 6 || second->second != 42 || after->second != 42;\n}\n",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source_sha256": "cb000df0020b627a7d78760d1bcc217567a10d346ac048275fdabc55a068114f"
    },
    {
      "name": "list-plain-default-ctor-constant-calls",
      "section": "list",
      "source": "#include <list>\nint fixed_value(int ignored) { return 13; }\nint bias() { return 4; }\nstruct Entry {\n  double fraction;\n  int value;\n  Entry() : fraction(4.5), value(fixed_value(bias())) {\n    value += 5;\n    fraction--;\n  }\n};\nint main() {\n  std::list<Entry> rows;\n  auto& first = rows.emplace_back();\n  rows.resize(2);\n  return &first != &rows.front() || first.value != 18 || rows.back().fraction != 3.5;\n}\n",
      "expected": "accept",
      "kind": "cpp17-operation",
      "source_sha256": "54cb728748b565f8034312026c0c9318394f102293e67185d9ebd002365180fb"
    },
    {
      "name": "list-plain-default-ctor-indirect-body-call",
      "section": "list",
      "source": "#include <list>\nvoid bump(int& n) { ++n; }\nvoid (*hook)(int&) = &bump;\nstruct Entry {\n  int value;\n  Entry() : value(5) { hook(value); }\n};\nint main() {\n  std::list<Entry> rows(1);\n  return rows.front().value != 6;\n}\n",
      "expected": "reject",
      "kind": "cpp17-negative",
      "source_sha256": "55d5b4cff98bc097c7152495f693ffdc54481d318809bb6b499004d01d9ed0fa"
    },
    {
      "name": "forward-list-plain-default-ctor-nonconstant-initializer-call",
      "section": "forward_list",
      "source": "#include <forward_list>\nint calls;\nint next_value() { return ++calls; }\nstruct Entry {\n  int value;\n  Entry() : value(next_value()) {}\n};\nint main() {\n  std::forward_list<Entry> rows(2);\n  return rows.front().value != 1 || calls != 2;\n}\n",
      "expected": "reject",
