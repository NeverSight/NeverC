      "name": "priority-ctor-comparator",
      "source": "#include <queue>\nint main(){std::less<int> compare;std::priority_queue<int> q(compare);\nif(!q.empty()||q.size()!=0)return 1;q.push(-7);q.push(12);q.push(3);\nif(q.top()!=12)return 2;q.pop();if(q.top()!=3)return 3;q.pop();return q.top()!=-7;}\n",
      "source_sha256": "a1af5ce1a396f3cb6f3e8c46c6dd38974544f81e61292f8bfdfe48ff1f0b6f0b",
      "expected_runtime_exit": 0,
      "public_header": "queue",
      "expected": "accept"
    },
    {
      "name": "priority-ctor-copy-vector",
      "source": "#include <queue>\n#include <vector>\nint main(){std::less<int> compare;std::vector<int> values{3,11,3,-5};\nconst auto& source=values;std::priority_queue<int> q(compare,source);\nif(q.size()!=4||q.top()!=11||&q.top()==&values[0])return 1;\nvalues[1]=99;if(q.top()!=11)return 2;\nint expected[4]={11,3,3,-5};for(int i=0;i!=4;++i){if(q.top()!=expected[i])return 3;q.pop();}\nreturn !q.empty()||values.size()!=4||values[1]!=99;}\n",
      "source_sha256": "9d0d09af6273940c5ddc2b94cb97091974d60e8fcd11d3bc6ae817e35eab97f5",
      "expected_runtime_exit": 0,
      "public_header": "queue",
      "expected": "accept"
    },
