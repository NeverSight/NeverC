      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() { std::unordered_set<int> values{3}; auto* p = &values; return p->begin(0) != p->end(0); }\n",
      "source_sha256": "d414f18aa9bfe4a79b96786c57df5116491efbe0d242afdaca7fc7a9e22fbada",
      "kind": "cpp17-operation"
    },
