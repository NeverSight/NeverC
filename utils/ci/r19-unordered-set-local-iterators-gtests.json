  "source_cases": [
    {
      "name": "unordered-set-local-iterators-bucket-boundary-keeps-collisions",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> values{0, 8, 1, 16, 17};\n  values.rehash(8);\n  const auto bucket = values.bucket(8);\n  unsigned visited = 0;\n  int sum = 0;\n  for (auto it = values.begin(bucket); it != values.end(bucket); ++it) {\n    sum += *it;\n    ++visited;\n  }\n  return visited != 3 || sum != 24 || values.bucket_size(bucket) != 3;\n}\n",
      "source_sha256": "17ec0244c13141c32c8d587a868e6d9457908bf64bf9d78ba4df0650252711cc",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-local-iterators-const-bucket-iteration-sees-duplicates",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> values{4, 12, 4, 12, 4, 7};\n  values.rehash(8);\n  const auto& read = values;\n  const auto bucket = read.bucket(4);\n  int visited = 0, fours = 0;\n  for (auto it = read.cbegin(bucket); it != read.cend(bucket);) {\n    const int key = *it++;\n    if (key != 4 && key != 12) return 1;\n    fours += key == 4;\n    ++visited;\n  }\n  return visited != 5 || fours != 3;\n}\n",
      "source_sha256": "e4ce593df87c7fdaab98ffa0af1117e64395476b11f87a85d88dc2f07f4fddb6",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-local-iterators-empty-bucket-and-copied-local-end",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> values{1, 3};\n  values.rehash(8);\n  const auto& read = values;\n  auto end = read.end(2);\n  auto copy = end;\n  return copy != read.begin(2) || end != read.cend(2);\n}\n",
      "source_sha256": "bac4de44fd8f5ca42577cbba368b7e4565ef40a900454595f6335ad20a873fb9",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-local-iterators-receiver-and-bucket-evaluated-once",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nusing Set = std::unordered_set<int>;\nint trace;\nconst Set& receiver(const Set& values) { trace = trace * 10 + 1; return values; }\nunsigned bucket() { trace = trace * 10 + 2; return 2; }\nint main() {\n  Set values{1};\n  values.rehash(8);\n  auto it = receiver(values).cbegin(bucket());\n  return trace != 12 || it != values.cend(2);\n}\n",
      "source_sha256": "34713cf8d8273c56c3ce444e543fbc08d7036586ffc903ce1927a9d138aa6d88",
      "kind": "cpp17-operation"
    },
    {
