  "programs": [
    {
      "name": "bind-callable-member-pointer",
      "gtest": "TranslateTest.CoreV2MemberSourceBindCallableMemberPointerRunAtBothOptimizations",
      "original_source_sha256": "07cc3ac6df8d085f2bac003a3196097b81c2deeab75263aa3701bac83475f3fe",
      "source": "#include <functional>\nstruct Counter { int value; int add(int x) { value += x; return value; } };\nextern \"C\" int replacement() {\n  Counter target{2};\n  auto b = std::bind(&Counter::add, std::ref(target), std::placeholders::_1);\n  int first = b(3);\n  int second = b(4);\n  return first == 5 && second == 9 && target.value == 9 ? 0 : 1;\n}\n\nint main() { return replacement(); }\n",
      "source_sha256": "805a58d770299dba5cb9ae91f441f19d6bae73259d497a5a469141446bc7d03a",
      "only_added_main_wrapper": "\nint main() { return replacement(); }\n",
      "optimizations": [
        "-O0",
        "-O2"
      ],
      "expected_exit_code": 0
    },
    {
      "name": "bind-member-owned-copy",
      "gtest": "TranslateTest.CoreV2MemberSourceBindMemberOwnedCopyRunAtBothOptimizations",
      "original_source_sha256": "986e3929dbc360438ae289f62684c84dee1e8cb29d8f263fa4a98e05cc339974",
      "source": "#include <functional>\nstruct Counter { int value; int add(int x) { value += x; return value; } };\nextern \"C\" int replacement() {\n  Counter target{4};\n  auto bound = std::bind(&Counter::add, target, std::placeholders::_1);\n  const int first = bound(3);\n  auto copy = bound;\n  const int independent = copy(2);\n  return first == 7 && independent == 9 && bound(1) == 8 && target.value == 4 ? 0 : 1;\n}\n\nint main() { return replacement(); }\n",
      "source_sha256": "f008b0f717b828391095fa835dc0fd9fe0c578e791d1ccb5e2fc49777032b5bf",
      "only_added_main_wrapper": "\nint main() { return replacement(); }\n",
      "optimizations": [
        "-O0",
        "-O2"
      ],
      "expected_exit_code": 0
    },
    {
      "name": "bind-member-pointer-receivers",
      "gtest": "TranslateTest.CoreV2MemberSourceBindMemberPointerReceiversRunAtBothOptimizations",
      "original_source_sha256": "a5797bc55f42d4cf43b0eb92c67ca77b83b1dcc9f2ec8aa3aee98dd28c90239e",
      "source": "#include <functional>\nstruct Counter { int value; int add(int x) { value += x; return value; } };\nextern \"C\" int replacement() {\n  Counter first{4}, second{10};\n  auto bound = std::bind(&Counter::add, &first, std::placeholders::_1);\n  auto incoming = std::bind(&Counter::add, std::placeholders::_1, 2);\n  return bound(3) == 7 && incoming(&second) == 12 && first.value == 7 && second.value == 12 ? 0 : 1;\n}\n\nint main() { return replacement(); }\n",
      "source_sha256": "3cefac8d523bc75c906bd2b7b4015997e75760254c51f53f12f91db314d526ad",
      "only_added_main_wrapper": "\nint main() { return replacement(); }\n",
      "optimizations": [
        "-O0",
        "-O2"
      ],
      "expected_exit_code": 0
    },
    {
      "name": "bind-member-incoming-object",
      "gtest": "TranslateTest.CoreV2MemberSourceBindMemberIncomingObjectRunAtBothOptimizations",
      "original_source_sha256": "3abd77a1bd462e3de92ee365600874233934e33125d30aa4f196e5ed2ba4a5b7",
      "source": "#include <functional>\nstruct Counter { int value; int add(int x) { value += x; return value; } };\nextern \"C\" int replacement() {\n  Counter target{4};\n  auto call = std::bind(&Counter::add, std::placeholders::_1, std::placeholders::_2);\n  const int result = call(target, 3);\n  return result == 7 && target.value == 7 ? 0 : 1;\n}\n\nint main() { return replacement(); }\n",
      "source_sha256": "59de2c8d82f380c8a810747187baed7266d9d22a5308ccff3f4083efeb1e37e2",
      "only_added_main_wrapper": "\nint main() { return replacement(); }\n",
      "optimizations": [
        "-O0",
        "-O2"
      ],
      "expected_exit_code": 0
    },
    {
      "name": "bind-member-const-method",
      "gtest": "TranslateTest.CoreV2MemberSourceBindMemberConstMethodRunAtBothOptimizations",
      "original_source_sha256": "fe19acc466aa39c2f6fac77fc614a37742b5576cb6687a977abb97bae273b757",
      "source": "#include <functional>\nstruct Counter { int value; int read(int x) const { return value + x; } };\nextern \"C\" int replacement() {\n  const Counter target{4};\n  auto borrowed = std::bind(&Counter::read, std::cref(target), std::placeholders::_1);\n  const auto owned = std::bind(&Counter::read, target, std::placeholders::_1);\n  return borrowed(3) == 7 && owned(5) == 9 && target.value == 4 ? 0 : 1;\n}\n\nint main() { return replacement(); }\n",
      "source_sha256": "05cf5d6ab83be399d26ffb4b03bd2a3b4eed71116e22650e3e6b28f2f07b5b16",
      "only_added_main_wrapper": "\nint main() { return replacement(); }\n",
      "optimizations": [
        "-O0",
        "-O2"
      ],
      "expected_exit_code": 0
    },
    {
      "name": "bind-member-data-reference",
      "gtest": "TranslateTest.CoreV2MemberSourceBindMemberDataReferenceRunAtBothOptimizations",
      "original_source_sha256": "136dbd5c48e51b89306c7e419db9ba8f120028e516c5b4c1eded5a24d5b8d6a5",
      "source": "#include <functional>\nstruct Counter { int value; };\nextern \"C\" int replacement() {\n  Counter target{4};\n  const auto borrowed = std::bind(&Counter::value, std::ref(target));\n  auto incoming = std::bind(&Counter::value, std::placeholders::_1);\n  auto pointer = std::bind(&Counter::value, &target);\n  borrowed() = 9;\n  incoming(target) += 3;\n  pointer() += 2;\n  return target.value == 14 && &borrowed() == &target.value ? 0 : 1;\n}\n\nint main() { return replacement(); }\n",
      "source_sha256": "69f6c2dcf73bb1508a037a98e36af83e48ebc9b345244cdc264e4df0823fd93f",
      "only_added_main_wrapper": "\nint main() { return replacement(); }\n",
      "optimizations": [
        "-O0",
        "-O2"
      ],
      "expected_exit_code": 0
    },
    {
      "name": "bind-member-distinct-targets",
      "gtest": "TranslateTest.CoreV2MemberSourceBindMemberDistinctTargetsRunAtBothOptimizations",
      "original_source_sha256": "00710e2b4840a6d41c98331bd5ca33659d9a2f25ba82adb5b3789327365b8fa9",
      "source": "#include <functional>\nstruct Counter {\n  int value;\n  int add(int x) { value += x; return value; }\n  int subtract(int x) { value -= x; return value; }\n};\nextern \"C\" int replacement() {\n  Counter target{4};\n  auto add = std::bind(&Counter::add, std::ref(target), std::placeholders::_1);\n  auto subtract = std::bind(&Counter::subtract, std::ref(target), std::placeholders::_1);\n  const auto copy = subtract;\n  const int first = add(3);\n  const int second = subtract(2);\n  return first == 7 && second == 5 && copy(1) == 4 && target.value == 4 ? 0 : 1;\n}\n\nint main() { return replacement(); }\n",
      "source_sha256": "4621733c58444bc24b783860cced3d478bc8e10a8555cd2c6c62e75fcc287564",
      "only_added_main_wrapper": "\nint main() { return replacement(); }\n",
      "optimizations": [
        "-O0",
        "-O2"
      ],
      "expected_exit_code": 0
    }
  ],
