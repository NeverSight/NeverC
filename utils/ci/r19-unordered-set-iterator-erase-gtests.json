      "expected": "reject",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() { std::unordered_set<int> values{5}; auto* p=&values; return p->erase(values.cbegin()) != values.end(); }\n",
      "source_sha256": "c7d5814fc7926bf4d2a33bce5dceffc2e2440b8f71157ae4432fe7c620c04f51",
