  "source_cases": [
    {
      "name": "unordered-set-iterator-erase-position-returns-successor",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> values{2, 5, 13};\n  const auto position = values.find(5);\n  auto successor = position;\n  ++successor;\n  const auto returned = values.erase(position);\n  return returned != successor || values.size() != 2 || values.count(5) || values.count(13) != 1;\n}\n",
      "source_sha256": "917ec6bbf98b89a0aabbf1f68fd3de0eb1aee92b75f2719a792e6aac797175c9",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-iterator-erase-multiset-erases-only-the-selected-duplicate",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> values{4, 4, 5, 4};\n  auto position = values.find(4);\n  auto successor = position;\n  ++successor;\n  if (values.erase(position) != successor || values.count(4) != 2) return 1;\n  return values.size() != 3 || values.count(5) != 1;\n}\n",
      "source_sha256": "e3cfd16113286488e582d5e2dd94c4262e019130bc3c586d27740a2edd7c493d",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-iterator-erase-half-open-range-returns-last",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_set<int> values{0, 8, 1, 16};\n  values.rehash(8);\n  auto first = values.begin();\n  auto last = first;\n  const int removed = *last;\n  ++last;\n  const int kept = *last;\n  auto next = values.erase(first, last);\n  if (next != last || *next != kept || values.count(removed)) return 1;\n  return values.count(kept) != 1 || values.size() != 3;\n}\n",
      "source_sha256": "e4803ef4b44cc2312bc506a26627c251aa54a225869f980e5ec618c9c932a842",
      "kind": "cpp17-operation"
    },
    {
      "name": "unordered-set-iterator-erase-empty-and-entire-multiset-ranges",
      "expected": "accept",
      "public_header": "unordered_set",
      "source": "#include <unordered_set>\nint main() {\n  std::unordered_multiset<int> values{1, -2, 1, -2};\n  const auto end = values.end();\n  if (values.erase(end, end) != end || values.size() != 4) return 1;\n  if (values.erase(values.cbegin(), end) != end || !values.empty()) return 2;\n  values.insert(7);\n  return values.count(7) != 1;\n}\n",
      "source_sha256": "5fbac47ebcfbe13185b58e456145a6928d6d7f30ec62e41f9a5b615000825d0b",
      "kind": "cpp17-operation"
    },
    {
