    {
      "name": "any-int-transfer-swap-and-reset",
      "source": "#include <any>\n#include <utility>\nint main() {\n  std::any first(8), second(11), vacant;\n  first.swap(second);\n  second.swap(vacant);\n  first = first;\n  first = std::move(first);\n  if (*std::any_cast<int>(&first) != 11 || second.has_value() || *std::any_cast<int>(&vacant) != 8)\n    return 1;\n  vacant = first;\n  first = std::move(second);\n  return first.has_value() || second.has_value() || *std::any_cast<int>(&vacant) != 11;\n}\n",
      "expected": "accept",
      "source_sha256": "8b82d5886ef2a3b75dc7b4a0b9dd4ec8c2a3fd1187ee661023ff369925fcb80f",
