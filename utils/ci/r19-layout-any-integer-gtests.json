    {
      "name": "any-int-copy-and-move-construction",
      "source": "#include <any>\n#include <utility>\nint main() {\n  std::any first(27);\n  std::any copy(first);\n  std::any moved(std::move(first));\n  if (first.has_value() || std::any_cast<int>(&first))\n    return 1;\n  auto* left = std::any_cast<int>(&copy);\n  auto* right = std::any_cast<int>(&moved);\n  if (!left || !right || left == right || *left != 27 || *right != 27)\n    return 2;\n  moved.reset();\n  return moved.has_value() || std::any_cast<int>(&moved) || *left != 27;\n}\n",
      "expected": "accept",
      "source_sha256": "8544d7cc6cfbf0647d9e8587ddf30bafd38fca4d1ff66b58191601d19d0840b8",
      "public_header": "any",
