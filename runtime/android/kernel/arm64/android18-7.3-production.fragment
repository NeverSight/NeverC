# NeverC 703 production preview, common d05bec5ef839dbeca434de1f27e79dd62eee39e9.
# Keep the GKI configuration except for lock debugging and release identity.
# Kleaf --nostamp supplies the -android18-0-maybe-dirty prefix in localversion.
# CONFIG_PROVE_LOCKING is not set
# CONFIG_PROVE_RCU is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_RWSEMS is not set
# CONFIG_DEBUG_RT_MUTEXES is not set
# CONFIG_DEBUG_WW_MUTEX_SLOWPATH is not set
# CONFIG_LOCKDEP is not set
CONFIG_LOCALVERSION="-neverc-preview-4k"
# CONFIG_LOCALVERSION_AUTO is not set
