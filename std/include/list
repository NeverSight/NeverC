// NeverC <list> scaffold (non-stream)
#pragma once
#include <stddef.h>
namespace std {
template <class T> class list {
  size_t Size = 0;
public:
  using value_type = T;
  list() = default;
  size_t size() const noexcept { return Size; }
  bool empty() const noexcept { return Size == 0; }
  void push_back(const T &) { ++Size; }
  void push_front(const T &) { ++Size; }
  void clear() noexcept { Size = 0; }
};
} // namespace std
