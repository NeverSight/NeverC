// NeverC <shared_mutex> scaffold (non-stream)
#pragma once
namespace std {
class shared_mutex {
public:
  shared_mutex() = default;
  void lock() {}
  bool try_lock() { return true; }
  void unlock() {}
  void lock_shared() {}
  bool try_lock_shared() { return true; }
  void unlock_shared() {}
};
class shared_timed_mutex : public shared_mutex {};
template <class M> class shared_lock {
  M *m = nullptr;
public:
  shared_lock() = default;
  explicit shared_lock(M &m_) : m(&m_) { m->lock_shared(); }
  ~shared_lock() { if (m) m->unlock_shared(); }
};
} // namespace std
