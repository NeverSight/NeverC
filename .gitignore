#==============================================================================#
# This file specifies intentionally untracked files that git should ignore.
# See: http://www.kernel.org/pub/software/scm/git/docs/gitignore.html
#
# This file is intentionally different from the output of `git svn show-ignore`,
# as most of those are useless.
#==============================================================================#

#==============================================================================#
# File extensions to be ignored anywhere in the tree.
#==============================================================================#
# Temp files created by most text editors.
.repro/
*~
# Merge files created by git.
*.orig
# Reject files created by patch.
*.rej
# Byte compiled python modules.
*.pyc
# vim swap files
.*.sw?
.sw?
#OS X specific files.
.DS_store
# Darwin DWARF companion bundles produced beside debug-linked images.
*.dSYM/
# windows executable files
*.exe
*.bin
# NeverC example build and release bundle state.
.nvk-build-extra
.nvk-release-bundle
.neverc-output.lock

# Ignore the user specified CMake presets in subproject directories.
/*/CMakeUserPresets.json

# Nested build directory
/build*

# Local BoringSSL checkout used only for TLS interop gates.
/third_party/boringssl

# build directory
compiler-rt-build/
runtimes-build/
install/

#==============================================================================#
# Explicit files to ignore (only matches one).
#==============================================================================#
# Various tag programs
/tags
/TAGS
/GPATH
/GRTAGS
/GSYMS
/GTAGS
/ID
.gitusers
autom4te.cache
cscope.files
cscope.out
autoconf/aclocal.m4
autoconf/autom4te.cache
/compile_commands.json
# Visual Studio built-in CMake configuration
/CMakeSettings.json
# CLion project configuration
/.idea
# NeverC programs
IRAutoGeneratorPost/
IRAutoGeneratorPre/
IRAutoGeneratorCodeGenPrepare/
#test/

#==============================================================================#
# Directories to ignore (do not add trailing '/'s, they skip symlinks).
#==============================================================================#
# VS2017 and VSCode config files.
.vscode
.vs
CppProperties.json
# pythonenv for github Codespaces.
pythonenv*
# clangd index. (".clangd" is a config file now, thus trailing slash).
.clangd/
.cache

local_docs/
.xwin-cache/
tests/neverc/Output/
tests/neverc/std/test_http
tests/neverc/std/test_http2
tests/neverc/std/test_tcp
tests/neverc/std/test_quic_frame
tests/neverc/std/test_quic_conn
tests/neverc/std/test_quic_loss
tests/neverc/std/test_http3
tests/neverc/std/test_http3_frame
tests/neverc/std/test_http3_server
neverc/build/


*.profraw
*.profdata
pgo-profiles/
.cursor/

