//===----------------------------------------------------------------------===//
//
// Portable make-recipe builtin command table.
//
// Consumed by Platform/BuiltinCommands.cpp as:
//   #define NEVERC_BUILTIN_COMMAND(Name, Handler) .Case(Name, Handler)
//   #include "Platform/Builtins/BuiltinCommands.def"
//
// Handler must be `bool (*)(llvm::ArrayRef<internal::Token>, int &)`.
// Keep this list sorted by command name (ASCII). Aliases may share a handler
// (e.g. `"["` and `"test"` both use tryExecuteTest) and need not be adjacent.
//
//===----------------------------------------------------------------------===//

#ifndef NEVERC_BUILTIN_COMMAND
#error "NEVERC_BUILTIN_COMMAND must be defined before including BuiltinCommands.def"
#endif

NEVERC_BUILTIN_COMMAND(":", tryExecuteColon)
