// Native far transfers: name, C type encoding, result width, attributes.
X86_NATIVE_FAR_TRANSFER(lcall16, "UsvC*", 16, "n")
X86_NATIVE_FAR_TRANSFER(lcall32, "UivC*", 32, "n")
X86_NATIVE_FAR_TRANSFER(lcall64, "ULLivC*", 64, "n")
X86_NATIVE_FAR_TRANSFER(ljmp16, "vvC*vC*", 0, "nr")
X86_NATIVE_FAR_TRANSFER(ljmp32, "vvC*vC*", 0, "nr")
X86_NATIVE_FAR_TRANSFER(ljmp64, "vvC*vC*", 0, "nr")
