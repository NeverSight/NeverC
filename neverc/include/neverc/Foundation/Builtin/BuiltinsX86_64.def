BUILTIN(__builtin_ia32_outdwordstring, "vUsvC*Ui", "n")

// Native processor-state effects. The list operations own their memory tables
// and return the actual RCX completion mask.
BUILTIN(__builtin_ia32_clts, "v", "n")
BUILTIN(__builtin_ia32_readcr, "ULLiIUi", "n")
BUILTIN(__builtin_ia32_writecr, "vIUiULLi", "n")
BUILTIN(__builtin_ia32_readdr, "ULLiIUi", "n")
BUILTIN(__builtin_ia32_writedr, "vIUiULLi", "n")
BUILTIN(__builtin_ia32_wrmsrns, "vUiULLi", "n")
BUILTIN(__builtin_ia32_rdmsrlist, "ULLivC*v*ULLi", "n")
BUILTIN(__builtin_ia32_wrmsrlist, "ULLivC*vC*ULLi", "n")

#undef BUILTIN
#undef TARGET_BUILTIN
#undef TARGET_HEADER_BUILTIN
