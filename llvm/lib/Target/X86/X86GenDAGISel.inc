  case 73: {
    // Predicate_X86fist32
    // Predicate_X86fp_to_i32mem
    // Predicate_X86fild32
    SDNode *N = Node;
    (void)N;

  return cast<MemIntrinsicSDNode>(N)->getMemoryVT() == MVT::i32;

  }
  case 74: {
    // Predicate_X86fist64
    // Predicate_X86fp_to_i64mem
    // Predicate_X86fild64
