  case 76: {
    // Predicate_X86fstf32
    // Predicate_X86fldf32
    SDNode *N = Node;
    (void)N;

  return cast<MemIntrinsicSDNode>(N)->getMemoryVT() == MVT::f32;

  }
  case 77: {
    // Predicate_X86fstf64
    // Predicate_X86fldf64
    SDNode *N = Node;
