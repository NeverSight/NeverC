    auto *N = cast<ConstantSDNode>(Node);
    (void)N;

  uint64_t Imm = N->getZExtValue() & 0x7;
  return (Imm == 0x00 || Imm == 0x03 || Imm == 0x04 || Imm == 0x07);

  }
  case 84: {
    // Predicate_fp32imm0
    // Predicate_fp64imm0
    // Predicate_fp16imm0
