  }
  case 37: {
    // Predicate_atomic_load_32
    // Predicate_atomic_store_32
    // Predicate_sextloadi32
    // Predicate_zextloadi32
    // Predicate_atomic_swap_32
    // Predicate_atomic_load_add_32
    SDNode *N = Node;
