    break;

  case X86::SBB32rr:
  case X86::SBB64rr:
  case X86::PCMPEQBrr:
  case X86::PCMPEQWrr:
  case X86::PCMPEQDrr:
  case X86::VPCMPEQBrr:
  case X86::VPCMPEQWrr:
  case X86::VPCMPEQDrr:
    if (ProcessorID == 5 || ProcessorID == 7 || ProcessorID == 15 || ProcessorID == 16 || ProcessorID == 17 || ProcessorID == 18) {
