bool X86GenSubtargetInfo::isZeroIdiom(const MachineInstr *MI, APInt &Mask) const {
  unsigned ProcessorID = getSchedModel().getProcessorID();
  switch(MI->getOpcode()) {
  default:
    break;
  case X86::VPERM2F128rr:
    if (ProcessorID == 7) {
      Mask.clearAllBits();
      return (
        MI->getOperand(1).getReg() == MI->getOperand(2).getReg()
        && MI->getOperand(3).getImm() == 136
      );
    }
    break;

  case X86::VXORPSZrr:
  case X86::VXORPDZrr:
  case X86::VPXORDZrr:
  case X86::VPXORQZrr:
  case X86::VXORPSZ128rr:
  case X86::VXORPDZ128rr:
  case X86::VPXORDZ128rr:
  case X86::VPXORQZ128rr:
  case X86::VXORPSZ256rr:
  case X86::VXORPDZ256rr:
  case X86::VPXORDZ256rr:
  case X86::VPXORQZ256rr:
  case X86::VPSUBBZrr:
  case X86::VPSUBWZrr:
  case X86::VPSUBDZrr:
  case X86::VPSUBQZrr:
  case X86::VPSUBBZ128rr:
  case X86::VPSUBWZ128rr:
  case X86::VPSUBDZ128rr:
  case X86::VPSUBQZ128rr:
  case X86::VPSUBBZ256rr:
  case X86::VPSUBWZ256rr:
  case X86::VPSUBDZ256rr:
  case X86::VPSUBQZ256rr:
    if (ProcessorID == 8 || ProcessorID == 12) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;

  case X86::XOR32rr_REV:
  case X86::XOR64rr_REV:
  case X86::SUB32rr_REV:
  case X86::SUB64rr_REV:
  case X86::VPSUBSBYrr:
  case X86::VPSUBSWYrr:
  case X86::VPSUBUSBYrr:
  case X86::VPSUBUSWYrr:
    if (ProcessorID == 17 || ProcessorID == 18) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;

  case X86::MMX_PXORrr:
  case X86::MMX_PANDNrr:
  case X86::MMX_PSUBBrr:
  case X86::MMX_PSUBDrr:
  case X86::MMX_PSUBQrr:
  case X86::MMX_PSUBWrr:
  case X86::MMX_PSUBSBrr:
  case X86::MMX_PSUBSWrr:
  case X86::MMX_PSUBUSBrr:
  case X86::MMX_PSUBUSWrr:
  case X86::MMX_PCMPGTBrr:
  case X86::MMX_PCMPGTDrr:
  case X86::MMX_PCMPGTWrr:
    if (ProcessorID == 5 || ProcessorID == 7 || ProcessorID == 15 || ProcessorID == 16) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;

  case X86::VPANDNYrr:
    if (ProcessorID == 15 || ProcessorID == 16 || ProcessorID == 17 || ProcessorID == 18) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;

  case X86::PSUBSBrr:
  case X86::PSUBSWrr:
  case X86::PSUBUSBrr:
  case X86::PSUBUSWrr:
  case X86::VPSUBSBrr:
  case X86::VPSUBSWrr:
  case X86::VPSUBUSBrr:
  case X86::VPSUBUSWrr:
    if (ProcessorID == 5 || ProcessorID == 7 || ProcessorID == 17 || ProcessorID == 18) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;

  case X86::ANDNPSrr:
  case X86::ANDNPDrr:
  case X86::PANDNrr:
  case X86::VANDNPSrr:
  case X86::VANDNPDrr:
  case X86::VPANDNrr:
  case X86::VANDNPSYrr:
  case X86::VANDNPDYrr:
    if (ProcessorID == 5 || ProcessorID == 7 || ProcessorID == 15 || ProcessorID == 16 || ProcessorID == 17 || ProcessorID == 18) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;

  case X86::VPCMPGTQYrr:
    if (ProcessorID == 6 || ProcessorID == 8 || ProcessorID == 12 || ProcessorID == 14 || ProcessorID == 15 || ProcessorID == 16 || ProcessorID == 17 || ProcessorID == 18) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;

  case X86::VPXORYrr:
  case X86::VPSUBBYrr:
  case X86::VPSUBWYrr:
  case X86::VPSUBDYrr:
  case X86::VPSUBQYrr:
  case X86::VPCMPGTBYrr:
  case X86::VPCMPGTWYrr:
  case X86::VPCMPGTDYrr:
    if (ProcessorID == 6 || ProcessorID == 8 || ProcessorID == 10 || ProcessorID == 12 || ProcessorID == 14 || ProcessorID == 15 || ProcessorID == 16 || ProcessorID == 17 || ProcessorID == 18) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;

  case X86::PCMPGTQrr:
    if (ProcessorID == 6 || ProcessorID == 7 || ProcessorID == 8 || ProcessorID == 9 || ProcessorID == 10 || ProcessorID == 12 || ProcessorID == 14 || ProcessorID == 15 || ProcessorID == 16 || ProcessorID == 17 || ProcessorID == 18) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;

  case X86::VXORPSYrr:
  case X86::VXORPDYrr:
    if (ProcessorID == 5 || ProcessorID == 6 || ProcessorID == 7 || ProcessorID == 8 || ProcessorID == 10 || ProcessorID == 12 || ProcessorID == 14 || ProcessorID == 15 || ProcessorID == 16 || ProcessorID == 17 || ProcessorID == 18) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;

  case X86::SUB32rr:
  case X86::SUB64rr:
  case X86::XOR64rr:
  case X86::PSUBBrr:
  case X86::PSUBWrr:
  case X86::PSUBDrr:
  case X86::PSUBQrr:
  case X86::PCMPGTBrr:
  case X86::PCMPGTDrr:
  case X86::PCMPGTWrr:
  case X86::VXORPSrr:
  case X86::VXORPDrr:
  case X86::VPXORrr:
  case X86::VPSUBBrr:
  case X86::VPSUBWrr:
  case X86::VPSUBDrr:
  case X86::VPSUBQrr:
  case X86::VPCMPGTBrr:
  case X86::VPCMPGTWrr:
  case X86::VPCMPGTDrr:
  case X86::VPCMPGTQrr:
    if (ProcessorID == 5 || ProcessorID == 6 || ProcessorID == 7 || ProcessorID == 8 || ProcessorID == 9 || ProcessorID == 10 || ProcessorID == 12 || ProcessorID == 14 || ProcessorID == 15 || ProcessorID == 16 || ProcessorID == 17 || ProcessorID == 18) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;

  case X86::XOR32rr:
  case X86::XORPSrr:
  case X86::XORPDrr:
  case X86::PXORrr:
    if (ProcessorID == 4 || ProcessorID == 5 || ProcessorID == 6 || ProcessorID == 7 || ProcessorID == 8 || ProcessorID == 9 || ProcessorID == 10 || ProcessorID == 12 || ProcessorID == 14 || ProcessorID == 15 || ProcessorID == 16 || ProcessorID == 17 || ProcessorID == 18) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;
  }

  return false;
} // X86GenSubtargetInfo::isZeroIdiom

bool X86GenSubtargetInfo::isDependencyBreaking(const MachineInstr *MI, APInt &Mask) const {
  if (isZeroIdiom(MI, Mask))
    return true;

  unsigned ProcessorID = getSchedModel().getProcessorID();
  switch(MI->getOpcode()) {
  default:
    break;
  case X86::SBB32rr_REV:
  case X86::SBB64rr_REV:
    if (ProcessorID == 17 || ProcessorID == 18) {
      Mask.clearAllBits();
      return MI->getOperand(1).getReg() == MI->getOperand(2).getReg();
    }
    break;

  case X86::CMP8rr:
  case X86::CMP8rr_REV:
  case X86::CMP16rr:
  case X86::CMP16rr_REV:
  case X86::CMP32rr_REV:
  case X86::CMP64rr_REV:
    if (ProcessorID == 17 || ProcessorID == 18) {
      Mask.clearAllBits();
      return MI->getOperand(0).getReg() == MI->getOperand(1).getReg();
    }
    break;

  case X86::VPCMPEQBYrr:
  case X86::VPCMPEQWYrr:
  case X86::VPCMPEQDYrr:
  case X86::VPCMPEQQYrr:
