#ifdef GET_INSTRINFO_MEM_OPERAND_SIZE
#undef GET_INSTRINFO_MEM_OPERAND_SIZE
namespace llvm {
namespace X86 {
LLVM_READONLY
static int getMemOperandSize(int OpType) {
  switch (OpType) {
  default: return 0;
  case OpTypes::i8mem:
  case OpTypes::i8mem_NOREX:
    return 8;

  case OpTypes::f16mem:
  case OpTypes::i16mem:
    return 16;

  case OpTypes::f32mem:
  case OpTypes::i32mem:
    return 32;

  case OpTypes::f64mem:
  case OpTypes::i64mem:
  case OpTypes::i64mem_TC:
  case OpTypes::vx64mem:
  case OpTypes::vx64xmem:
    return 64;

  case OpTypes::f80mem:
    return 80;

  case OpTypes::f128mem:
  case OpTypes::i128mem:
  case OpTypes::vx128mem:
  case OpTypes::vx128xmem:
  case OpTypes::vy128mem:
  case OpTypes::vy128xmem:
    return 128;

  case OpTypes::f256mem:
  case OpTypes::i256mem:
  case OpTypes::vx256mem:
  case OpTypes::vx256xmem:
  case OpTypes::vy256mem:
  case OpTypes::vy256xmem:
  case OpTypes::vz256mem:
    return 256;

  case OpTypes::f512mem:
  case OpTypes::i512mem:
  case OpTypes::i512mem_GR16:
  case OpTypes::i512mem_GR32:
  case OpTypes::i512mem_GR64:
  case OpTypes::vy512xmem:
  case OpTypes::vz512mem:
    return 512;

  }
}
} // end namespace X86
} // end namespace llvm
#endif // GET_INSTRINFO_MEM_OPERAND_SIZE

#ifdef GET_INSTRINFO_LOGICAL_OPERAND_SIZE_MAP
#undef GET_INSTRINFO_LOGICAL_OPERAND_SIZE_MAP
namespace llvm {
namespace X86 {
LLVM_READONLY static unsigned
getLogicalOperandSize(uint16_t Opcode, uint16_t LogicalOpIdx) {
  return LogicalOpIdx;
}
LLVM_READONLY static inline unsigned
getLogicalOperandIdx(uint16_t Opcode, uint16_t LogicalOpIdx) {
  auto S = 0U;
  for (auto i = 0U; i < LogicalOpIdx; ++i)
    S += getLogicalOperandSize(Opcode, i);
  return S;
}
} // end namespace X86
} // end namespace llvm
