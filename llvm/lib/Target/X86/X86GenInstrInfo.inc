    CEFBS_None, // XORPDrr = 18419
    CEFBS_None, // XORPSrm = 18420
    CEFBS_None, // XORPSrr = 18421
    CEFBS_None, // XRELEASE_PREFIX = 18422
    CEFBS_None, // XRESLDTRK = 18423
    CEFBS_None, // XRSTOR = 18424
    CEFBS_In64BitMode, // XRSTOR64 = 18425
    CEFBS_None, // XRSTORS = 18426
    CEFBS_In64BitMode, // XRSTORS64 = 18427
    CEFBS_None, // XSAVE = 18428
    CEFBS_In64BitMode, // XSAVE64 = 18429
    CEFBS_None, // XSAVEC = 18430
    CEFBS_In64BitMode, // XSAVEC64 = 18431
    CEFBS_None, // XSAVEOPT = 18432
    CEFBS_In64BitMode, // XSAVEOPT64 = 18433
    CEFBS_None, // XSAVES = 18434
    CEFBS_In64BitMode, // XSAVES64 = 18435
    CEFBS_None, // XSETBV = 18436
    CEFBS_None, // XSHA1 = 18437
    CEFBS_None, // XSHA256 = 18438
    CEFBS_None, // XSTORE = 18439
    CEFBS_None, // XSUSLDTRK = 18440
    CEFBS_None, // XTEST = 18441
  };

  assert(Opcode < 18442);
  return FeatureBitsets[RequiredFeaturesRefs[Opcode]];
}

} // end namespace X86_MC
} // end namespace llvm
#endif // GET_COMPUTE_FEATURES

#ifdef GET_AVAILABLE_OPCODE_CHECKER
#undef GET_AVAILABLE_OPCODE_CHECKER
namespace llvm {
namespace X86_MC {
bool isOpcodeAvailable(unsigned Opcode, const FeatureBitset &Features) {
  FeatureBitset AvailableFeatures = computeAvailableFeatures(Features);
  FeatureBitset RequiredFeatures = computeRequiredFeatures(Opcode);
  FeatureBitset MissingFeatures =
      (AvailableFeatures & RequiredFeatures) ^
      RequiredFeatures;
  return !MissingFeatures.any();
}
} // end namespace X86_MC
} // end namespace llvm
#endif // GET_AVAILABLE_OPCODE_CHECKER

#ifdef ENABLE_INSTR_PREDICATE_VERIFIER
#undef ENABLE_INSTR_PREDICATE_VERIFIER
#include <sstream>

namespace llvm {
namespace X86_MC {

#ifndef NDEBUG
static const char *SubtargetFeatureNames[] = {
  "Feature_In64BitMode",
  nullptr
};

#endif // NDEBUG

void verifyInstructionPredicates(
    unsigned Opcode, const FeatureBitset &Features) {
#ifndef NDEBUG
  FeatureBitset AvailableFeatures = computeAvailableFeatures(Features);
  FeatureBitset RequiredFeatures = computeRequiredFeatures(Opcode);
  FeatureBitset MissingFeatures =
      (AvailableFeatures & RequiredFeatures) ^
      RequiredFeatures;
  if (MissingFeatures.any()) {
    std::ostringstream Msg;
    Msg << "Attempting to emit " << &X86InstrNameData[X86InstrNameIndices[Opcode]]
        << " instruction but the ";
    for (unsigned i = 0, e = MissingFeatures.size(); i != e; ++i)
      if (MissingFeatures.test(i))
        Msg << SubtargetFeatureNames[i] << " ";
    Msg << "predicate(s) are not met";
    report_fatal_error(Msg.str().c_str());
  }
#endif // NDEBUG
}
} // end namespace X86_MC
} // end namespace llvm
#endif // ENABLE_INSTR_PREDICATE_VERIFIER

